        <mxCell id="titulo" value="&lt;b&gt;DG-CST-003&lt;/b&gt; · Caja blanca del Verificador criptográfico: firma, cadena, estampa y revocación" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1F2A36;" vertex="1" parent="1">

        </mxCell>
        <mxCell id="nF" value="&lt;b&gt;Fallas inyectadas.&lt;/b&gt; Toxiproxy corta el RNIC simulado o le suma latencia; la ECD simulada se apaga con la lista vencida. El inyector las dispara según plan.tsv, y la ventana nocturna se dispara a mano." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="2440" y="130" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="nA" value="&lt;b&gt;Amenaza a la validez.&lt;/b&gt; Los carriles tienen CPU propia, pero comparten disco, memoria y bus del equipo, y Kafka es de un solo nodo: el aislamiento medido aquí es una cota inferior del de producción." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="2440" y="260" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="nV" value="&lt;b&gt;Por qué aparece cada pieza.&lt;/b&gt; Lo que está en Orquídea corre el mismo .jar que DG-DEP-003; simuladores, Toxiproxy, k6 y la observabilidad existen solo para medir." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="2440" y="390" width="360" height="95" as="geometry" />
        </mxCell>
        <mxCell id="lg" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;caja 3D: nodo · «device»: hardware o servidor; «executionEnvironment»: el entorno que corre el software (JVM 21, contenedor)&lt;br&gt;×N, 1..3: cuántas instancias corren · caja 3D doble: varias instancias&lt;br&gt;«artifact»: lo que se instala en el nodo (el .jar, su configuración, un script) · «schema» y tópicos: lo que se configura en el COTS&lt;br&gt;ícono de hoja: archivo desplegable · bandeja con sobres: tópico · cilindro: esquema de datos&lt;br&gt;línea continua: ruta de comunicación, con protocolo y puerto · punteada fina: métricas · gris punteado: fuera del foco&lt;br&gt;relleno ámbar: artefacto de un ASR (ahí se aplica la táctica) · borde ámbar: participa sin modificarse · gris: externo&lt;br&gt;nota amarilla: decisión (ADR) y su precio · los componentes lógicos están en DG-CMP-003" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="700" height="190" as="geometry" />
        </mxCell>
        <mxCell id="cv" value="&lt;b&gt;Convención ASR&lt;/b&gt; · cada elemento lleva la insignia de los ASR en cuyo alcance está" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="40" y="1424" width="700" height="132" as="geometry" />
        </mxCell>
        <mxCell id="cv_bD01" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="cv">
          <mxGeometry x="12" y="26" width="54" height="17" as="geometry" />
        </mxCell>
        <mxCell id="cv_tD01" value="Ningún archivo se rechaza por la caída de un sistema externo (foco)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="cv">
          <mxGeometry x="74" y="24" width="600" height="20" as="geometry" />

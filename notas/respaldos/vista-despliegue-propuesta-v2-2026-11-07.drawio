        <mxCell id="e12" edge="1" parent="1" source="n_rep" style="endArrow=none;startArrow=none;strokeColor=#2B3642;strokeWidth=1.3;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.703;entryDx=0;entryDy=0;" target="z_terc" value="«HTTPS» API">

        </mxCell>
        <mxCell id="traz" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" value="&lt;b&gt;Trazabilidad ASR → nodos y artefactos&lt;/b&gt; &amp;nbsp;(★ crítico)&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;ASR&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;Atributo&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;Artefacto (relleno)&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;Participa sin modificarse&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;Decisión de despliegue&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;Medida&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;&lt;span style=&quot;background:#1F4E79;color:#fff;font-weight:bold;border-radius:4px;padding:0 4px&quot;&gt;ASR-D01&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Disponibilidad · corrección&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;JVM Monitor (monitor.jar) · JVM Reprocesador (reprocesador.jar) · adaptador dentro de carril.jar · tópico pendientes&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;JVM Recepción · Kafka · esquema repositorio · /custodia · tópico estado-terceros&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Log durable y custodia antes del acuse; monitor y reprocesador en JVM propias, con una sola instancia activa&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;100 % de los archivos válidos procesados dentro de los días de reintento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;&lt;span style=&quot;background:#2C7873;color:#fff;font-weight:bold;border-radius:4px;padding:0 4px&quot;&gt;ASR-L04&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Latencia&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;JVM Carril A y JVM Carril B (carril.jar con su .yml) · recepcion.jar (clasificador) · tópicos carril-a y carril-b&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Balanceador · Kafka&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Un contenedor, pool y CPU por carril; A siempre arriba; B con capacidad reservada&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;p99 ≤ 3 s por archivo pequeño con 5 masivos en proceso&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;&lt;span style=&quot;background:#5B3F8C;color:#fff;font-weight:bold;border-radius:4px;padding:0 4px&quot;&gt;ASR-S06&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Seguridad · prevención&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;recepcion.jar (verificador y caché de revocación) · esquema evidencia&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;JVM Reprocesador (reverifica) · PostgreSQL · ruta a la ECD&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Verificación dentro de cada instancia de recepción con caché propia; evidencia de solo anexar&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;0 archivos aceptados sin firma, firmante, cadena, estampa y revocación verificadas&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="220" width="1630" x="770" y="1290" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>

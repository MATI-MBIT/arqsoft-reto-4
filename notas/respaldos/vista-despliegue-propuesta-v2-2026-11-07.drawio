        <mxCell id="e13" edge="1" parent="1" source="n_mon" style="endArrow=none;startArrow=none;strokeColor=#2B3642;strokeWidth=1.3;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="z_terc" value="ping/echo · «HTTPS»">
          <mxGeometry relative="1" x="0.6" as="geometry">

        </mxCell>
        <mxCell id="nBal" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" value="&lt;b&gt;Propuesta · balanceador.&lt;/b&gt; Varias instancias de recepción necesitan quien reparta las peticiones y termine HTTPS. &lt;i&gt;Precio:&lt;/i&gt; un salto más antes del acuse." vertex="1">
          <mxGeometry height="105" width="270" x="290" y="105" as="geometry" />
        </mxCell>
        <mxCell id="e14" edge="1" parent="1" source="nBal" style="endArrow=none;dashed=1;dashPattern=2 3;strokeColor=#B9A65A;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="n_bal" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nRec" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" value="&lt;b&gt;ADR-006 · ADR-007.&lt;/b&gt; Cada instancia de recepcion.jar verifica en streaming y guarda en memoria su copia de la lista de revocación, que refresca contra la ECD. &lt;i&gt;Precio:&lt;/i&gt; cada instancia tiene su propia ventana de refresco." vertex="1">
          <mxGeometry height="105" width="360" x="620" y="105" as="geometry" />
        </mxCell>
        <mxCell id="e15" edge="1" parent="1" source="nRec" style="endArrow=none;dashed=1;dashPattern=2 3;strokeColor=#B9A65A;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="n_rec" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nCar" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" value="&lt;b&gt;ADR-005 · bulkhead.&lt;/b&gt; carril.jar se despliega dos veces con configuración distinta: cada carril tiene contenedor, CPU, pool, conexiones y adaptador propios, así un masivo no le quita recursos a un pequeño. A no escala desde cero (C-02) y B reserva capacidad para 5 masivos (C-03). &lt;i&gt;Precio:&lt;/i&gt; capacidad ociosa en B sin masivos." vertex="1">
          <mxGeometry height="90" width="770" x="1030" y="105" as="geometry" />
        </mxCell>
        <mxCell id="e16" edge="1" parent="1" source="nCar" style="endArrow=none;dashed=1;dashPattern=2 3;strokeColor=#B9A65A;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=0.766;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="n_cb" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nRep" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" value="&lt;b&gt;ADR-002 · ADR-003.&lt;/b&gt; Monitor y reprocesador corren con una sola instancia activa: la ventana no corre dos veces [SUPUESTO → equipo]. El reprocesador trae su propio adaptador, así no le quita capacidad a los carriles y fija su ritmo sobre la base (C-04). &lt;i&gt;Precio:&lt;/i&gt; punto único hasta que se defina su relevo." vertex="1">
          <mxGeometry height="150" width="270" x="1880" y="800" as="geometry" />
        </mxCell>
        <mxCell id="e17" edge="1" parent="1" source="nRep" style="endArrow=none;dashed=1;dashPattern=2 3;strokeColor=#B9A65A;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" target="n_rep" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1860" y="860" />
              <mxPoint x="1860" y="682.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="nK" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" value="&lt;b&gt;ADR-001 · log durable antes del acuse.&lt;/b&gt; El acuse sale cuando Kafka confirma la escritura del evento: lo acusado no se pierde aunque caiga una JVM. &lt;i&gt;Precio:&lt;/i&gt; un viaje de red al nodo de datos dentro del tiempo del acuse." vertex="1">
          <mxGeometry height="70" width="560" x="310" y="1125" as="geometry" />
        </mxCell>
        <mxCell id="e18" edge="1" parent="1" source="nK" style="endArrow=none;dashed=1;dashPattern=2 3;strokeColor=#B9A65A;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="n_kaf" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nP" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" value="&lt;b&gt;ADR-004 · ADR-008 · una sola base.&lt;/b&gt; Archivo y llave quedan en la misma base, así la transacción local no cruza nodos; la evidencia va en su propio esquema, de solo anexar. &lt;i&gt;Precio:&lt;/i&gt; la base es el punto único de escritura hasta que BCR fije sus réplicas." vertex="1">
          <mxGeometry height="70" width="520" x="900" y="1125" as="geometry" />
        </mxCell>
        <mxCell id="e19" edge="1" parent="1" source="nP" style="endArrow=none;dashed=1;dashPattern=2 3;strokeColor=#B9A65A;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="n_pg" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nRed" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" value="&lt;b&gt;Redundancia.&lt;/b&gt; Las instancias de cada JVM, los brokers de Kafka y las réplicas de PostgreSQL siguen abiertos [PREGUNTA → BCR]. La topología activo-activo (ADR-17 de BCR) es infraestructura y queda fuera de esta iteración." vertex="1">
          <mxGeometry height="100" width="350" x="1450" y="1125" as="geometry" />
        </mxCell>
        <mxCell id="nPla" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" value="&lt;b&gt;Plataforma.&lt;/b&gt; Cada servicio es un .jar de Spring Boot sobre JVM 21 en un contenedor eclipse-temurin:21-jre, como en el prototipo [SUPUESTO → BCR]. Kafka y PostgreSQL son los que aprobó BCR (C-01)." vertex="1">
          <mxGeometry height="110" width="270" x="1880" y="970" as="geometry" />
        </mxCell>
        <mxCell id="lg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;caja 3D: nodo · «device»: hardware o servidor; «executionEnvironment»: el entorno que corre el software (JVM 21, contenedor)&lt;br&gt;×N, 1..3: cuántas instancias corren · caja 3D doble: varias instancias&lt;br&gt;«artifact»: lo que se instala en el nodo (el .jar, su configuración, un script) · «schema» y tópicos: lo que se configura en el COTS&lt;br&gt;ícono de hoja: archivo desplegable · bandeja con sobres: tópico · cilindro: esquema de datos&lt;br&gt;línea continua: ruta de comunicación, con protocolo y puerto · punteada fina: métricas · gris punteado: fuera del foco&lt;br&gt;relleno ámbar: artefacto de un ASR (ahí se aplica la táctica) · borde ámbar: participa sin modificarse · gris: externo&lt;br&gt;nota amarilla: decisión (ADR) y su precio · los componentes lógicos están en DG-CMP-003" vertex="1">
          <mxGeometry height="190" width="700" x="40" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="cv" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" value="&lt;b&gt;Convención ASR&lt;/b&gt; · cada elemento lleva la insignia de los ASR en cuyo alcance está" vertex="1">
          <mxGeometry height="132" width="700" x="40" y="1494" as="geometry" />
        </mxCell>
        <mxCell id="cv_bD01" parent="cv" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" value="ASR-D01" vertex="1">
          <mxGeometry height="17" width="54" x="12" y="26" as="geometry" />
        </mxCell>

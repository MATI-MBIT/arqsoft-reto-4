        <mxCell id="cv_fat" value="relleno: artefacto del ASR" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="cv">
          <mxGeometry x="74" y="96" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cv_fp" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="cv">
          <mxGeometry x="290" y="98" width="54" height="17" as="geometry" />
        </mxCell>
        <mxCell id="cv_fpt" value="contorno punteado: participa sin modificarse" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="cv">
          <mxGeometry x="352" y="96" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="traz" value="&lt;b&gt;Trazabilidad ASR → contenedores y artefactos del experimento&lt;/b&gt; &amp;nbsp;(★ crítico)&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;ASR&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;Atributo&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;Artefacto (relleno)&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;Participa sin modificarse&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;Decisión de despliegue&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;Medida&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;&lt;span style=&quot;background:#1F4E79;color:#fff;font-weight:bold;border-radius:4px;padding:0 4px&quot;&gt;ASR-D01&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Disponibilidad · corrección&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;toxiproxy (corta el RNIC) · monitor-terceros · reprocesador · tópico pendientes&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;recepcion · kafka · volumen custodia · tercero-rnic-sim · k6&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Caída del RNIC inyectada en caliente; reproceso en la ventana&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;100 % de los archivos válidos procesados dentro de los días de reintento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;&lt;span style=&quot;background:#2C7873;color:#fff;font-weight:bold;border-radius:4px;padding:0 4px&quot;&gt;ASR-L04&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Latencia&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;carril-a (2 CPU) · carril-b (3 CPU) · recepcion · tópicos carril-a y carril-b · pequenos.js y masivos.js&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;remitente-sim · kafka&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Contenedores, CPU y pool separados por carril, con la misma imagen&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;p99 ≤ 3 s por archivo pequeño con 5 masivos en proceso&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;&lt;span style=&quot;background:#5B3F8C;color:#fff;font-weight:bold;border-radius:4px;padding:0 4px&quot;&gt;ASR-S06&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Seguridad · prevención&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;recepcion.jar (verificador y caché de revocación)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;ecd-sim · reprocesador · postgres&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;ECD simulada que se apaga con la lista vencida&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;0 archivos aceptados sin firma, firmante, cadena, estampa y revocación verificadas&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="770" y="1220" width="1630" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>

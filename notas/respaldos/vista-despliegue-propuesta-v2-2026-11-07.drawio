        <mxCell id="cv_fpt" parent="cv" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" value="contorno punteado: participa sin modificarse" vertex="1">

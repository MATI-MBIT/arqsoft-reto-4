          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1200" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e06" value="«TCP» Kafka · «JDBC»" style="endArrow=none;startArrow=none;strokeColor=#2B3642;strokeWidth=1.3;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.98;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_cb" target="n_dat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e07" value="API&lt;br&gt;«protocolo TBD»" style="endArrow=none;startArrow=none;strokeColor=#2B3642;strokeWidth=1.3;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.195;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_ca" target="z_terc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e08" value="API&lt;br&gt;«protocolo TBD»" style="endArrow=none;startArrow=none;strokeColor=#2B3642;strokeWidth=1.3;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.756;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_cb" target="z_terc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e09" value="ping/echo · API · «protocolo TBD»" style="endArrow=none;startArrow=none;strokeColor=#2B3642;strokeWidth=1.3;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_sop" target="z_terc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1100" y="285" />
              <mxPoint x="1855" y="285" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" value="notificación · «protocolo TBD»" style="endArrow=none;startArrow=none;strokeColor=#2B3642;strokeWidth=1.3;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_sop" target="n_rem">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="820" y="278" />
              <mxPoint x="127.5" y="278" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" value="«JDBC»" style="endArrow=none;startArrow=none;strokeColor=#9AA5B1;dashed=1;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.267;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_ent" target="n_dat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nR" value="&lt;b&gt;ADR-006 · ADR-007 · verificación en la recepción.&lt;/b&gt; Cada instancia verifica en streaming y guarda en memoria su copia de la lista de revocación, que refresca contra la ECD. &lt;i&gt;Precio:&lt;/i&gt; cada instancia tiene su propia ventana de refresco; un certificado revocado tras el último refresco se acepta hasta el siguiente." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="290" y="130" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="" style="endArrow=none;dashed=1;dashPattern=2 3;strokeColor=#B9A65A;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="nR" target="n_rec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nS" value="&lt;b&gt;ADR-002 · ADR-003 · nodo de soporte.&lt;/b&gt; El monitor y el reprocesador corren aparte de los carriles, y el reprocesador trae su propia instancia de integración: la ventana nocturna no le quita capacidad a los carriles y fija su propio ritmo sobre la base (C-04). Una sola instancia activa evita que la ventana corra dos veces. &lt;i&gt;Precio:&lt;/i&gt; una tercera instancia de integración." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="760" y="130" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="" style="endArrow=none;dashed=1;dashPattern=2 3;strokeColor=#B9A65A;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="nS" target="n_sop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nC" value="&lt;b&gt;ADR-005 · bulkhead físico.&lt;/b&gt; Cada carril tiene nodo, pool e instancia de integración propios: un masivo no comparte CPU ni conexiones con un pequeño. El carril A no escala desde cero (C-02) y el B reserva capacidad para 5 masivos (C-03). &lt;i&gt;Precio:&lt;/i&gt; capacidad ociosa en B cuando no hay masivos." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="1230" y="130" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="" style="endArrow=none;dashed=1;dashPattern=2 3;strokeColor=#B9A65A;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="nC" target="n_ca">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nK" value="&lt;b&gt;ADR-001 · log durable antes del acuse.&lt;/b&gt; El acuse sale cuando Kafka confirma la escritura del evento: lo acusado no se pierde aunque caiga un nodo de aplicación. &lt;i&gt;Precio:&lt;/i&gt; un viaje de red al nodo de datos dentro del tiempo del acuse." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="310" y="1140" width="470" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="" style="endArrow=none;dashed=1;dashPattern=2 3;strokeColor=#B9A65A;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="nK" target="n_kaf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nP" value="&lt;b&gt;ADR-004 · ADR-008 · una sola base.&lt;/b&gt; Archivo y llave viven en la misma base, así la transacción local no cruza nodos. La evidencia va en su propio esquema, de solo anexar. &lt;i&gt;Precio:&lt;/i&gt; la base es el punto único de escritura hasta que BCR fije sus réplicas." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="800" y="1140" width="470" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e16" value="" style="endArrow=none;dashed=1;dashPattern=2 3;strokeColor=#B9A65A;html=1;rounded=0;jettySize=auto;jumpStyle=arc;jumpSize=8;fontSize=10;fontFamily=Helvetica;fontColor=#33414F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="nP" target="n_pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nRed" value="&lt;b&gt;Redundancia.&lt;/b&gt; El número de instancias de cada nodo y las réplicas del nodo de datos siguen abiertos [PREGUNTA → BCR]. La caja doble marca los nodos que corren varias instancias. La topología activo-activo (ADR-17 de BCR) es infraestructura y queda fuera de esta iteración." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="1330" y="965" width="300" height="105" as="geometry" />
        </mxCell>
        <mxCell id="nPlat" value="&lt;b&gt;Plataforma.&lt;/b&gt; Contenedores con Java 21, la misma del prototipo [SUPUESTO → BCR]. Kafka en modo KRaft y PostgreSQL son los que aprobó BCR (C-01)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="1330" y="1090" width="300" height="72" as="geometry" />
        </mxCell>
        <mxCell id="lg" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;caja 3D: nodo · «device» es hardware o un sistema completo; «executionEnvironment», el entorno donde corre el software&lt;br&gt;caja 3D doble: el nodo corre varias instancias&lt;br&gt;▭ con ícono de componente: componente de DG-CMP-003 desplegado en el nodo&lt;br&gt;«artifact»: lo que se instala o se configura en un COTS · bandeja con sobres: tópico · cilindro: esquema de datos&lt;br&gt;línea continua: ruta de comunicación, con su protocolo · gris punteado: dentro del alcance, fuera del foco&lt;br&gt;relleno ámbar: artefacto de un ASR (ahí se aplica la táctica) · borde ámbar: participa sin modificarse · gris: externo&lt;br&gt;nota amarilla: decisión (ADR) y su precio · los arcos marcan cruces de líneas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="40" y="1290" width="680" height="160" as="geometry" />
        </mxCell>
        <mxCell id="cv" value="&lt;b&gt;Convención ASR&lt;/b&gt; · cada elemento lleva la insignia de los ASR en cuyo alcance está" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="40" y="1464" width="680" height="132" as="geometry" />
        </mxCell>
        <mxCell id="cv_bD01" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="cv">
          <mxGeometry x="12" y="26" width="54" height="17" as="geometry" />
        </mxCell>
        <mxCell id="cv_tD01" value="Ningún archivo se rechaza por la caída de un sistema externo (foco)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="cv">
          <mxGeometry x="74" y="24" width="510" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cv_bL04" value="ASR-L04" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#2C7873;strokeColor=#2C7873;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="cv">
          <mxGeometry x="12" y="48" width="54" height="17" as="geometry" />
        </mxCell>
        <mxCell id="cv_tL04" value="Aislamiento de carga entre archivos masivos y pequeños" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="cv">
          <mxGeometry x="74" y="46" width="510" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cv_bS06" value="ASR-S06" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#5B3F8C;strokeColor=#5B3F8C;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="cv">
          <mxGeometry x="12" y="70" width="54" height="17" as="geometry" />
        </mxCell>
        <mxCell id="cv_tS06" value="Ningún archivo se acepta sin validación criptográfica completa" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="cv">
          <mxGeometry x="74" y="68" width="510" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cv_fa" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="cv">
          <mxGeometry x="12" y="98" width="54" height="17" as="geometry" />
        </mxCell>
        <mxCell id="cv_fat" value="relleno: artefacto del ASR" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="cv">
          <mxGeometry x="74" y="96" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cv_fp" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="cv">
          <mxGeometry x="290" y="98" width="54" height="17" as="geometry" />
        </mxCell>
        <mxCell id="cv_fpt" value="contorno punteado: participa sin modificarse" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="cv">
          <mxGeometry x="352" y="96" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="traz" value="&lt;b&gt;Trazabilidad ASR → elementos de despliegue&lt;/b&gt; &amp;nbsp;(★ crítico)&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;ASR&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;Atributo&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;Artefacto (relleno)&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;Participa sin modificarse&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;Decisión de despliegue&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:3px 6px;border-bottom:1px solid #9AA5B1;font-size:10px&quot;&gt;Medida&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;&lt;span style=&quot;background:#1F4E79;color:#fff;font-weight:bold;border-radius:4px;padding:0 4px&quot;&gt;ASR-D01&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Disponibilidad · corrección&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;nodoSoporte (monitor, reprocesador e integración de la ventana) · Integración en cada carril · tópico pendientes&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;nodoRecepcion · nodoDatos (Kafka, esquema repositorio) · tópico estado-terceros&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Log durable antes del acuse; soporte aislado de los carriles, con ventana a ritmo propio&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;100 % de los archivos válidos procesados dentro de los días de reintento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;&lt;span style=&quot;background:#2C7873;color:#fff;font-weight:bold;border-radius:4px;padding:0 4px&quot;&gt;ASR-L04&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Latencia&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;nodoCarrilA · nodoCarrilB · Recepción (clasificador) · tópicos carril-a y carril-b&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;nodoDatos (Kafka)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Un nodo y un pool por carril; A siempre arriba; B con capacidad reservada&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;p99 ≤ 3 s por archivo pequeño con 5 masivos en proceso&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;&lt;span style=&quot;background:#5B3F8C;color:#fff;font-weight:bold;border-radius:4px;padding:0 4px&quot;&gt;ASR-S06&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Seguridad · prevención&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Verificador y caché de revocación en nodoRecepcion · Registro de evidencia · esquema evidencia&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;nodoSoporte (Resultados retiene, el reprocesador reverifica) · PostgreSQL · ruta a la ECD&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;Verificación en el nodo de recepción con caché por instancia; evidencia de solo anexar&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top;font-size:10px;border-bottom:1px solid #E1E6EB&quot;&gt;0 archivos aceptados sin firma, firmante, cadena, estampa y revocación verificadas&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1">
          <mxGeometry x="750" y="1290" width="1600" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dg-dep-002" name="DG-DEP-002 · Despliegue del experimento local">
    <mxGraphModel grid="0" page="0" background="#FFFFFF">
      <root>

le=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="1"><mxGeometry x="471.4" y="297" width="143.9" height="42" as="geometry"/></mxCell><mxCell id="wLiv" value="«thread»&lt;br&gt;&lt;u&gt;trabajadorLiviano : CarrilLiviano&lt;/u&gt; [1..*]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;«tactic» {id = DIS-22}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{pool propio · N = TBD}&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fontSize=12;fillColor=#FFF4D6;strokeColor=#B8860B;fila=C1;" vertex="1" parent="1"><mxGeometry x="719.5" y="496" width="248.7" height="77.2" as="geometry"/></mxCell><mxCell id="wPes" value="«thread»&lt;br&gt;&lt;u&gt;trabajadorDeBloques : CarrilPesado&lt;/u&gt; [1..*]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;«tactic» {id = DIS-22}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{pool propio · reservado para 5 masivos}&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fontSize=12;fillColor=#FFF4D6;strokeColor=#B8860B;fila=C1;" vertex="1" parent="1"><mxGeometry x="407.2" y="496" width="272.3" height="77.2" as="geometry"/></mxCell><mxCell id="tPend" value="«queue»&lt;br&gt;&lt;u&gt;retryQueue : TopicoPendientes&lt;/u&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{durable · maxAttempts = TBD}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=58;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFF4D6;strokeColor=#B8860B;fila=C1;" vertex="1" parent="1"><mxGeometry x="434.1" y="736.6" width="191.7" height="58" as="geometry"/></mxCell><mxCell id="ges" value="«thread»&lt;br&gt;&lt;u&gt;gestor : GestorDePendientes&lt;/u&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;«tactic» {id = LAT-02}&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fontSize=12;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="1"><mxGeometry x="426.8" y="958" width="206.3" height="64" as="geometry"/></mxCell><mxCell id="lim" value="&lt;u&gt;limitador : TokenBucket&lt;/u&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{guarded} {tasa = TBD}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=42;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="1"><mxGeometry x="454.6" y="1193.4" width="150.6" height="42" as="geometry"/></mxCell><mxCell id="dlq" value="«queue»&lt;br&gt;&lt;u&gt;deadLetterChannel : Apartadas&lt;/u&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=42;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="1"><mxGeometry x="40" y="1193.4" width="192.4" height="42" as="geometry"/></mxCell><mxCell id="repo" value="&lt;u&gt;declaraciones : RepositorioDeDeclaraciones&lt;/u&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{guarded} {idempotencyKey = (archivo, declaración)}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=42;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="1"><mxGeometry x="884.9" y="1193.4" width="283.7" height="42" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Bulkhead&lt;/b&gt;: ADR-002: dos pools que&lt;br&gt;no comparten hilos; un masivo no le&lt;br&gt;quita un hilo a un pequeño.&lt;br&gt;Precio: capacidad ociosa en el pesado" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="1"><mxGeometry x="175" y="499.2" width="216.2" height="70.8" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;No esperar al externo&lt;/b&gt;: ADR-006: con&lt;br&gt;el circuito abierto el hilo publica&lt;br&gt;la declaración como pendiente&lt;br&gt;y sigue con la siguiente" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="1"><mxGeometry x="202.5" y="730.2" width="215.6" height="70.8" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Qué se sincroniza&lt;/b&gt;: Trabajador y gestor&lt;br&gt;pueden escribir la misma declaración;&lt;br&gt;la clave (archivo, declaración) evita el&lt;br&gt;doble resultado (ADR-007)" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="1"><mxGeometry x="645.3" y="1179" width="223.6" height="70.8" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Drenaje&lt;/b&gt;: ADR-006: una&lt;br&gt;ficha por reanudación; tras&lt;br&gt;maxAttempts la declaración&lt;br&gt;se aparta, nunca se rechaza" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="1"><mxGeometry x="272.4" y="1179" width="166.2" height="70.8" as="geometry"/></mxCell><mxCell id="r0" value="publicar(pequeño)" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2B3642;fontColor=#1F2A36;" edge="1" parent="1" source="recep" target="tLiv"><mxGeometry relat
e10" value="(7)" style="endArrow=classic;endSize=8;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#55606E;strokeWidth=1.2;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0;exitY=0.8;entryX=0.5;entryY=1;" edge="1" parent="1" source="s_or" target="t_pe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="512"/><mxPoint x="1120" y="700"/><mxPoint x="675" y="700"/></Array></mxGeometry></mxCell><mxCell id="e11" value="(8)" style="endArrow=classic;endSize=8;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#55606E;strokeWidth=1.2;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0;exitY=0.5;entryX=1;entryY=0.77;" edge="1" parent="1" source="s_mo" target="t_et"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="617"/><mxPoint x="1150" y="628"/></Array></mxGeometry></mxCell><mxCell id="e12" value="(9)" style="endArrow=classic;endSize=8;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#55606E;strokeWidth=1.2;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0;exitY=0.5;entryX=0.2;entryY=1;" edge="1" parent="1" source="s_re" target="t_pe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="752"/><mxPoint x="1100" y="728"/><mxPoint x="600" y="728"/></Array></mxGeometry></mxCell><mxCell id="e13" value="(10)" style="endArrow=classic;endSize=8;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#55606E;strokeWidth=1.2;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=1;exitY=0.1;entryX=0;entryY=0.5;" edge="1" parent="1" source="d_p" target="r_repo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="persiste" style="endArrow=classic;endSize=8;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#55606E;strokeWidth=1.2;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="r_repo" target="db_rep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="persiste" style="endArrow=classic;endSize=8;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#55606E;strokeWidth=1.2;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="r_evi" target="db_evi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t16" value="&lt;b&gt;Flujos&lt;/b&gt;&lt;br&gt;(1) Recepción custodia el archivo y registra llave y acuse en una transacción (ADR-001, ADR-004)&lt;br&gt;(2) Recepción publica el archivo en carril-a o carril-b según sus bytes (ADR-005)&lt;br&gt;(3) Recepción anexa la evidencia, solo INSERT (ADR-008)&lt;br&gt;(4) El verificador lee y refresca la caché de revocación (ADR-007)&lt;br&gt;(5) El verificador escribe la verificación y el certificado (ADR-006)&lt;br&gt;(6) Cada carril consume solo su tópico&lt;br&gt;(7) El orquestador lee estado-terceros y publica la declaración pendiente (ADR-003)&lt;br&gt;(8) El monitor publica los cambios de estado de cada tercero (ADR-002)&lt;br&gt;(9) El reprocesador consume los pendientes en la ventana nocturna&lt;br&gt;(10) Carriles, orquestador, reprocesador y resultados escriben en el repositorio: declaraciones, datos canónicos de terceros, pendientes, resultados y notificaciones" style="rounded=1;arcSize=3;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3AE;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1060" height="185" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;[PREGUNTA → equipo]&lt;/b&gt; ¿Los bytes del XML custodiado van en la tabla archivo o en un almacenamiento de objetos con su ruta? DG-CMP-003 solo dice «archivos custodiados»." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="520" height="80" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;[SUPUESTO → equipo]&lt;/b&gt; Nombres de tablas y columnas, y estructura de los mensajes, propuestos a partir de DG-CLS-001." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="580" y="1110" width="520" height="80" as="geometry"/></mxCell><mxCell id="b19" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;" vertex="1" parent="s_rec"><mxGeometry x="8" y="-9" width="54" height="17" as="geometry"/></mxCell><mxCell id="b20" value="ASR-L04" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#2E7D6E;strokeColor=#2E7D6E;fontColor=#FFFFFF;" vertex="1" parent="s_rec"><mxGeometry x="66" y="-9" width="54" height="17" as="geometry"/></mxCell><mxCell id="b21" value="ASR-S06" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=#5B3A8C;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#5B3A8C;" vertex=
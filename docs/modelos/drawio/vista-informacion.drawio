le=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=1;exitY=0.25;entryX=0.75;entryY=1;html=1;" edge="1" parent="1" source="s_pen" target="s_pen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="190"/><mxPoint x="1080" y="290"/><mxPoint x="950" y="290"/></Array></mxGeometry></mxCell><mxCell id="e12" value="ventana [caído e intentos = maxAttempts]" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0.35;exitY=1;entryX=0.35;entryY=0;" edge="1" parent="1" source="s_pen" target="s_not"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="ventana [sigue caído] / reprogramar" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=1;exitY=0.3;entryX=0.75;entryY=1;" edge="1" parent="1" source="s_not" target="s_not"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="440"/><mxPoint x="1080" y="530"/><mxPoint x="950" y="530"/></Array></mxGeometry></mxCell><mxCell id="e14" value="ventana [tercero de vuelta]" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0;exitY=0.5;entryX=1;entryY=0.9;" edge="1" parent="1" source="s_not" target="s_enr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="460"/><mxPoint x="440" y="230"/></Array></mxGeometry></mxCell><mxCell id="e15" value="datosDelTercero" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s_enr" target="s_eda"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="aplicarReglas" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s_eda" target="s_dec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="resultadoEscrito" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s_dec" target="fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="&lt;b&gt;ADR-003.&lt;/b&gt; Pendiente y Notificada nunca se descartan: cada noche se reprograman, y vuelven a EnEnriquecimiento cuando el tercero vuelve. &lt;i&gt;Precio:&lt;/i&gt; lo pendiente espera a la noche (SUP-10)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="1130" y="150" width="400" height="90" as="geometry"/></mxCell><mxCell id="e19" value="" style="endArrow=none;dashed=1;dashPattern=4 3;strokeColor=#7A8794;html=1;rounded=0;" edge="1" parent="1" source="n18" target="s_pen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="&lt;b&gt;Medida ASR-D01.&lt;/b&gt; 100 % de los archivos válidos procesados dentro de los días de reintento; después de notificar, la declaración sigue pendiente." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="1130" y="420" width="400" height="80" as="geometry"/></mxCell><mxCell id="e21" value="" style="endArrow=none;dashed=1;dashPattern=4 3;strokeColor=#7A8794;html=1;rounded=0;" edge="1" parent="1" source="n20" target="s_not"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="&lt;b&gt;ADR-004.&lt;/b&gt; El resultado se escribe una sola vez por (archivo, declaración), aunque carril y reprocesador compitan por escribirlo." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="420" y="620" width="420" height="80" as="geometry"/></mxCell><mxCell id="e23" value="" style="endArrow=none;dashed=1;dashPattern=4 3;strokeColor=#7A8794;html=1;rounded=0;" edge="1" parent="1" source="n22" target="s_dec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="El diagrama muestra un tercero. Si la declaración espera a varios, hay una DeclaracionPendiente por tercero (DG-CLS-001), con su propio contador de intentos." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="420" y="720" width="420" height="80" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;[PREGUNTA → BCR]&lt;/b&gt; timeout por llamada, hora de la ventana y maxAttempts." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="1130" y="600" width="400" height="56" as="geometry"/></mxCell><mxCell id="lg26" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;▢ estado (nombre / actividades entry, do) · ● estado inicial · ◉ estado final&lt;br&gt;transición: evento [guarda] / acción · ventana = evento de la ventana nocturna de reproceso&lt;br&gt;nota: decisión (ADR), restricción {…} o dato pendiente [PREGUNTA]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#A0AAB4;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="560" height="81" as="geometry"/></mxCell><mxCell id="cv27" value="&lt;b&gt;Convención ASR&lt;/b&gt; · cada elemento lleva la insignia de los ASR en cuyo alcance está" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#A0AAB4;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="1017" width="560" height="98" as="geometry"/></mxCell><mxCell id="b28" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="1047" width="54" height="17" as="geometry"/></mxCell><mxCell id="t29" value="Ningún archivo se rechaza por la caída de un sistema externo (foco)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="114" y="1045" width="470" height="20" as="geometry"/></mxCell><mxCell id="b30" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="1077" width="54" height="17" as="geometry"/></mxCell><mxCell id="t31" value="relleno: artefacto del ASR" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="114" y="1075" width="180" height="20" as="geometry"/></mxCell><mxCell id="b32" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="310" y="1077" width="54" height="17" as="geometry"/></mxCell><mxCell id="t33" value="contorno punteado: participa sin modificarse" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="372" y="1075" width="230" height="20" as="geometry"/></mxCell><mxCell id="tz34" value="&lt;b&gt;Trazabilidad ASR → elementos de la arquitectura&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(★ crítico)&lt;/font&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;margin-top:6px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;ASR&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Atributo&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Artefacto (relleno)&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Participa sin modificarse&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Táctica principal&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Medida&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#1F4E79;color:#FFFFFF;font-weight:bold;padding:1px 6px;border-radius:4px&quot;&gt;ASR-D01&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Disponibilidad · recuperación&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Pendiente · Notificada · Decidida&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;EnEnriquecimiento&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Pendientes durables y ventana nocturna (ADR-003)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;100 % de los archivos válidos procesados dentro de los días de reintento&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#A0AAB4;fontSize=12;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="640" y="920" width="900" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dg-stm-003" name="DG-STM-003 · Estado de un tercero en el monitor"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f1" value="&lt;b&gt;stm&lt;/b&gt; DG-STM-003 · EstadoTercero: ping/echo, timeout y regreso del tercero" style="shape=umlFrame;whiteSpace=wrap;html=1;width=620;height=30;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#3B4B5C;strokeWidth=1.4;fontSize=14;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1460" height="840" as="geometry"/></mxCell><mxCell id="t2" value="máquina de estados UML · contexto: clase EstadoTercero (DG-CLS-001), una instancia por tercero · ASR-D01 · ADR-002" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="660" y="26" width="800" height="20" as="geometry"/></mxCell><mxCell id="i" value="" style="ellipse;html=1;fillColor=#1F2A36;strokeColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="26" height="26" as="geometry"/></mxCell><mxCell id="s_dis" value="&lt;b&gt;Disponible&lt;/b&gt;&lt;hr style=&quot;border:none;border-top:1px solid #3B4B5C;margin:6px -8px 4px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;do / sondear cada T_sondeo&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B4B5C;strokeWidth=1.3;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontSize=12;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="260" y="150" width="300" height="58" as="geometry"/></mxCell><mxCell id="b3" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;" vertex="1" parent="s_dis"><mxGeometry x="10" y="-9" width="54" height="17" as="geometry"/></mxCell><mxCell id="s_cai" value="&lt;b&gt;Caido&lt;/b&gt;&lt;hr style=&quot;border:none;border-top:1px solid #3B4B5C;margin:6px -8px 4px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;do / sondear cada T_sondeo&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B4B5C;strokeWidth=1.3;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontSize=12;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="260" y="400" width="300" height="58" as="geometry"/></mxCell><mxCell id="b4" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;" vertex="1" parent="s_cai"><mxGeometry x="10" y="-9" width="54" height="17" as="geometry"/></mxCell><mxCell id="e5" value="arranque" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=1;exitY=0.5;entryX=0.25;entryY=0;" edge="1" parent="1" source="i" target="s_dis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="335" y="118"/></Array></mxGeometry></mxCell><mxCell id="e6" value="sinEco, timeout [fallos &amp;lt; N] / fallos++" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=1;exitY=0.2;entryX=0.8;entryY=0;html=1;" edge="1" parent="1" source="s_dis" target="s_dis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="165"/><mxPoint x="610" y="120"/><mxPoint x="500" y="120"/></Array></mxGeometry></mxCell><mxCell id="e7" value="sinEco, timeout [fallos = N]&lt;br&gt;/ publicar(estado-terceros)" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0;exitY=0.6;entryX=0;entryY=0.5;html=1;" edge="1" parent="1" source="s_dis" target="s_cai"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="184"/><mxPoint x="200" y="425"/></Array></mxGeometry></mxCell><mxCell id="e8" value="ecoATiempo&lt;br&gt;/ fallos := 0;&lt;br&gt;publicar(estado-terceros)" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=1;exitY=0.5;entryX=1;entryY=0.7;html=1;" edge="1" parent="1" source="s_cai" target="s_dis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="425"/><mxPoint x="630" y="190"/></Array></mxGeometry></mxCell><mxCell id="n9" value="&lt;b&gt;ADR-002.&lt;/b&gt; La lentitud cuenta como caída: un eco que no llega en T_echo o una llamada que vence su timeout son fallos. Solo se publican los cambios de estado." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="400" height="90" as="geometry"/></mxCell><mxCell id="e10" value="" style="endArrow=none;dashed=1;dashPattern=4 3;strokeColor=#7A8794;html=1;rounded=0;" edge="1" parent="1" source="n9" target="s_dis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="Al volver a Disponible, el orquestador y el reprocesador leen el nuevo estado en estado-terceros y retoman lo pendiente en la siguiente ventana." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="760" y="230" width="400" height="80" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Precio.&lt;/b&gt; El monitor también puede caer; entonces el timeout de cada adaptador sigue protegiendo. No detecta datos errados (R-002a)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="760" y="330" width="400" height="70" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;[PREGUNTA → BCR]&lt;/b&gt; T_sondeo, T_echo, N y qué latencia cuenta como «extrema»." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="760" y="420" width="400" height="56" as="geometry"/></mxCell><mxCell id="lg14" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;▢ estado (nombre / actividades entry, do) · ● estado inicial · ◉ estado final&lt;br&gt;transición: evento [guarda] / acción · ventana = evento de la ventana nocturna de reproceso&lt;br&gt;nota: decisión (ADR), restricción {…} o dato pendiente [PREGUNTA]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#A0AAB4;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="560" height="81" as="geometry"/></mxCell><mxCell id="cv15" value="&lt;b&gt;Convención ASR&lt;/b&gt; · cada elemento lleva la insignia de los ASR en cuyo alcance está" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#A0AAB4;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="717" width="560" height="98" as="geometry"/></mxCell><mxCell id="b16" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="747" width="54" height="17" as="geometry"/></mxCell><mxCell id="t17" value="Ningún archivo se rechaza por la caída de un sistema externo (foco)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="114" y="745" width="470" height="20" as="geometry"/></mxCell><mxCell id="b18" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="777" width="54" height="17" as="geometry"/></mxCell><mxCell id="t19" value="relleno: artefacto del ASR" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="114" y="775" width="180" height="20" as="geometry"/></mxCell><mxCell id="b20" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="310" y="777" width="54" height="17" as="geometry"/></mxCell><mxCell id="t21" value="contorno punteado: participa sin modificarse" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="372" y="775" width="230" height="20" as="geometry"/></mxCell><mxCell id="tz22" value="&lt;b&gt;Trazabilidad ASR → elementos de la arquitectura&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(★ crítico)&lt;/font&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;margin-top:6px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;ASR&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Atributo&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Artefacto (relleno)&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Participa sin modificarse&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Táctica principal&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Medida&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#1F4E79;color:#FFFFFF;font-weight:bold;padding:1px 6px;border-radius:4px&quot;&gt;ASR-D01&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Disponibilidad · detección&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Caido&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Disponible&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Ping/echo y timeout (ADR-002)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;100 % de los archivos válidos procesados dentro de los días de reintento&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#A0AAB4;fontSize=12;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="640" y="620" width="820" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
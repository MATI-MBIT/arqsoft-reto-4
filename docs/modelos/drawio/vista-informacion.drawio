ntColor=#1F2A36;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="k_mig" target="k_dat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n55" value="&lt;b&gt;ADR-004.&lt;/b&gt; La llave es única por archivo; el resultado se escribe una vez por (archivo, declaración)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="360" height="66" as="geometry"/></mxCell><mxCell id="n56" value="&lt;b&gt;ADR-006.&lt;/b&gt; {estado = RESUELTO solo si todos los atributos de la VerificacionCriptografica son VALIDO}" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="360" height="66" as="geometry"/></mxCell><mxCell id="n57" value="&lt;b&gt;S06 · firmante.&lt;/b&gt; {CertificadoFirmante.sujeto corresponde al Remitente que envía el archivo}" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="360" height="66" as="geometry"/></mxCell><mxCell id="n58" value="&lt;b&gt;ADR-003.&lt;/b&gt; Una DeclaracionPendiente se reprograma cada noche; al agotar los días de reintento queda notificada y sigue pendiente." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="60" y="940" width="360" height="70" as="geometry"/></mxCell><mxCell id="e59" value="" style="endArrow=none;dashed=1;dashPattern=4 3;strokeColor=#7A8794;html=1;rounded=0;" edge="1" parent="1" source="n58" target="k_pen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n60" value="&lt;b&gt;ADR-005.&lt;/b&gt; carril se fija al recibir, por el tamaño en bytes." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="60" y="1025" width="360" height="56" as="geometry"/></mxCell><mxCell id="n61" value="&lt;b&gt;Modelo canónico (DG-CMP-003).&lt;/b&gt; Cada adaptador de la frontera anticorrupción traduce la respuesta de STM, ANTA, MAMC o RNIC a una subclase de DatoTercero; el núcleo nunca ve el formato del tercero." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="1230" y="900" width="750" height="70" as="geometry"/></mxCell><mxCell id="e62" value="" style="endArrow=none;dashed=1;dashPattern=4 3;strokeColor=#7A8794;html=1;rounded=0;" edge="1" parent="1" source="n61" target="k_dat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n63" value="&lt;b&gt;[SUPUESTO → equipo]&lt;/b&gt; Valores de Decision y Resultado, y atributos de negocio de Declaracion (moneda, monto, tasa, documentoTitular) son propuesta. TipoOperacion sale de «Problema y alcance»; los estados, de DG-STM-001 y DG-STM-002." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=10;fontFamily=
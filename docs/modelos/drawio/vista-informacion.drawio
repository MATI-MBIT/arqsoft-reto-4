FF;strokeColor=#3B4B5C;strokeWidth=1.3;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontSize=12;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="330" height="58" as="geometry"/></mxCell><mxCell id="b5" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;" vertex="1" parent="s_not"><mxGeometry x="10" y="-9" width="54" height="17" as="geometry"/></mxCell><mxCell id="s_eda" value="&lt;b&gt;Enriquecida&lt;/b&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B4B5C;strokeWidth=1.3;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontSize=12;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="220" height="34" as="geometry"/></mxCell><mxCell id="s_dec" value="&lt;b&gt;Decidida&lt;/b&gt;&lt;hr style=&quot;border:none;border-top:1px solid #3B4B5C;margin:6px -8px 4px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;entry / escribir resultado una vez&lt;br&gt;por (archivo, declaración)&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B4B5C;strokeWidth=1.3;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontSize=12;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="260" height="74" as="geometry"/></mxCell><mxCell id="b6" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;" vertex="1" parent="s_dec"><mxGeometry x="10" y="-9" width="54" height="17" as="geometry"/></mxCell><mxCell id="fin" value="" style="ellipse;html=1;shape=endState;fillColor=#1F2A36;strokeColor=#1F2A36;" vertex="1" pa
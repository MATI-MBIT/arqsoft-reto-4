=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#5B3A8C;strokeColor=#5B3A8C;fontColor=#FFFFFF;" vertex="1" parent="t_evi"><mxGeometry x="8" y="-9" width="54" height="17" as="geometry"/></mxCell><mxCell id="lg57" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;Domain: zona de la arquitectura · Service: componente de DG-CMP-003&lt;br&gt;Repository (con cilindro): componente que guarda datos · Database (cilindro): almacén físico&lt;br&gt;Table: tópico «topic» de Kafka o tabla «table» de PostgreSQL, con su owner y sus llaves&lt;br&gt;flecha numerada: flujo de escritura o lectura (ver «Flujos»)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#A0AAB4;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="560" height="96" as="geometry"/></mxCell><mxCell id="cv58" value="&lt;b&gt;Convención ASR&lt;/b&gt; · cada elemento lleva la insignia de los ASR en cuyo alcance está" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#A0AAB4;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="1432" width="560" height="146" as="geometry"/></mxCell><mxCell id="b59" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="1462" width="54" height="17" as="geometry"/></mxCell><mxCell id="t60" value="Ningún archivo se rechaza por la caída de un sistema externo (foco)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="114" y="1460" width="470" height="20" as="geometry"/></mxCell><mxCell id="b61" value="ASR-L04" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#2E7D6E;strokeColor=#2E7D6E;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="1486" width="54" height="17" as="geometry"/></mxCell><mxCell id="t62" value="Aislamiento de carga entre archivos masivos y pequeños" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="114" y="1484" width="470" height="20" as="geometry"/></mxCell><mxCell id="b63" value="ASR-S06" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#5B3A8C;strokeColor=#5B3A8C;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="1510" width="54" height="17" as="geometry"/></mxCell><mxCell id="t64" value="Ningún archivo se acepta sin validación criptográfica completa" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="114" y="1508" width="470" height="20" as="geometry"/></mxCell><mxCell id="b65" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="1540" width="54" height="17" as="geometry"/></mxCell><mxCell id="t66" value="relleno: artefacto del ASR" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="114" y="1538" width="180" height="20" as="geometry"/></mxCell><mxCell id="b67" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="310" y="1540" width="54" height="17" as="geometry"/></mxCell><mxCell id="t68" value="contorno punteado: participa sin modificarse" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="372" y="1538" width="230" height="20" as="geometry"/></mxCell><mxCell id="tz69" value="&lt;b&gt;Trazabilidad ASR → elementos de la arquitectura&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(★ crítico)&lt;/font&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;margin-top:6px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;ASR&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Atributo&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Artefacto (relleno)&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Participa sin modificarse&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Táctica principal&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Medida&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#1F4E79;color:#FFFFFF;font-weight:bold;padding:1px 6px;border-radius:4px&quot;&gt;ASR-D01&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Disponibilidad · recuperación&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;tópico pendientes · declaracion_pendiente · dato_tercero · resultado_declaracion · llave_archivo · notificacion&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Kafka · Repositorio de archivos · archivo · declaracion · acuse · estado-terceros&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Pendientes durables y ventana nocturna · llave de idempotencia&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;100 % de los archivos válidos procesados dentro de los días de reintento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#2E7D6E;color:#FFFFFF;font-weight:bold;padding:1px 6px;border-radius:4px&quot;&gt;ASR-L04&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Latencia&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;tópicos carril-a y carril-b · Carril A · Carril B · Recepción (clasificador)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Kafka · archivo&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Dos carriles aislados con enrutador por tamaño&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;p99 ≤ 3 s por archivo pequeño con 5 masivos en proceso&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#5B3A8C;color:#FFFFFF;font-weight:bold;padding:1px 6px;border-radius:4px&quot;&gt;ASR-S06&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Seguridad · prevención&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;verificacion_criptografica · certificado_firmante · caché de revocación · entrada_evidencia&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;archivo · resultado_definitivo · esquema evidencia&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Verificación completa con resultado retenido&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;0 archivos aceptados sin firma, firmante, cadena, estampa y revocación verificadas&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#A0AAB4;fontSize=12;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="640" y="1320" width="1980" height="216" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dg-stm-001" name="DG-STM-001 · Ciclo de vida del archivo"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f1" value="&lt;b&gt;stm&lt;/b&gt; DG-STM-001 · Archivo: ningún camino llega a Resuelto sin pasar por Verificado" style="shape=umlFrame;whiteSpace=wrap;html=1;width=620;height=30;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#3B4B5C;strokeWidth=1.4;fontSize=14;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1500" height="1400" as="geometry"/></mxCell><mxCell id="t2" value="máquina de estados UML · contexto: clase Archivo (DG-CLS-001) · ASR-S06, ASR-D01 · ADR-004, ADR-006, ADR-007" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="660" y="26" width="840" height="20" as="geometry"/></mxCell><mxCell id="i" value="" style="ellipse;html=1;fillColor=#1F2A36;strokeColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="497" y="80" width="26" height="26" as="geometry"/></mxCell><mxCell id="s_rec" value="&lt;b&gt;Recibido&lt;/b&gt;&lt;hr style=&quot;border:none;border-top:1px solid #3B4B5C;margin:6px -8px 4px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;entry / custodiar; registrar llave; verificar&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B4B5C;strokeWidth=1.3;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontSize=12;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="380" y="160" width="260" height="58" as="geometry"/></mxCell><mxCell id="b3" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;" vertex="1" parent="s_rec"><mxGeometry x="10" y="-9" width="54" height="17" as="geometry"/></mxCell><mxCell id="b4" value="ASR-S06" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=#5B3A8C;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#5B3A8C;" vertex="1" parent="s_rec"><mxGeometry x="68" y="-9" width="54" height="17" as="geometry"/></mxCell><mxCell id="s_vp" value="&lt;b&gt;VerificacionPendiente&lt;/b&gt;&lt;hr style=&quot;border:none;border-top:1px solid #3B4B5C;margin:6px -8px 4px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;entry / marcar verificación pendiente&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B4B5C;strokeWidth=1.3;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontSize=12;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="360" y="400" width="300" height="58" as="geometry"/></mxCell><mxCell id="b5" value="ASR-S06" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#5B3A8C;strokeColor=#5B3A8C;fontColor=#FFFFFF;" vertex="1" parent="s_vp"><mxGeometry x="10" y="-9" width="54" height="17" as="geometry"/></mxCell><mxCell id="b6" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;" vertex="1" parent="s_vp"><mxGeometry x="68" y="-9" width="54" height="17" as="geometry"/></mxCell><mxCell id="s_rch" value="&lt;b&gt;Rechazado&lt;/b&gt;&lt;hr style=&quot;border:none;border-top:1px solid #3B4B5C;margin:6px -8px 4px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;entry / registrar causa&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B4B5C;strokeWidth=1.3;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontSize=12;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="80" y="640" width="220" height="58" as="geometry"/></mxCell><mxCell id="b7" value="ASR-S06" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=#5B3A8C;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#5B3A8C;" vertex="1" parent="s_rch"><mxGeometry x="10" y="-9" width="54" height="17" as="geometry"/></mxCell><mxCell id="s_ver" value="&lt;b&gt;Verificado&lt;/b&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B4B5C;strokeWidth=1.3;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontSize=12;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="760" y="640" width="220" height="34" as="geometry"/></mxCell><mxCell id="b8" value="ASR-S06" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#5B3A8C;strokeColor=#5B3A8C;fontColor=#FFFFFF;" vertex="1" parent="s_ver"><mxGeometry x="10" y="-9" width="54" height="17" as="geometry"/></mxCell><mxCell id="s_res" value="&lt;b&gt;Resuelto&lt;/b&gt;&lt;hr style=&quot;border:none;border-top:1px solid #3B4B5C;margin:6px -8px 4px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;entry / escribir resultado definitivo&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B4B5C;strokeWidth=1.3;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;fontSize=12;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="760" y="840" width="220" height="58" as="geometry"/></mxCell><mxCell id="b9" value="ASR-S06" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=#5B3A8C;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#5B3A8C;" vertex="1" parent="s_res"><mxGeometry x="10" y="-9" width="54" height="17" as="geometry"/></mxCell><mxCell id="fin1" value="" style="ellipse;html=1;shape=endState;fillColor=#1F2A36;strokeColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="175" y="880" width="30" height="30" as="geometry"/></mxCell><mxCell id="fin2" value="" style="ellipse;html=1;shape=endState;fillColor=#1F2A36;strokeColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="855" y="1030" width="30" height="30" as="geometry"/></mxCell><mxCell id="e10" value="últimoByte" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="i" target="s_rec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="[inválido o duplicado] / rollback" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="s_rec" target="s_rch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="190"/></Array></mxGeometry></mxCell><mxCell id="e12" value="[verificado] / commit; acuse" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="s_rec" target="s_ver"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="190"/></Array></mxGeometry></mxCell><mxCell id="e13" value="[ECD caída y caché vencida] / commit; acuse de custodia" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s_rec" target="s_vp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="ventana [ECD caída e intentos &amp;lt; maxAttempts]&lt;br&gt;/ reprogramar; intentos++" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0;exitY=0.3;entryX=0.2;entryY=0;html=1;" edge="1" parent="1" source="s_vp" target="s_vp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="425"/><mxPoint x="320" y="370"/><mxPoint x="420" y="370"/></Array></mxGeometry></mxCell><mxCell id="e15" value="ventana [ECD caída e intentos = maxAttempts]&lt;br&gt;/ notificar al remitente" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0.37;exitY=1;entryX=0.67;entryY=1;html=1;" edge="1" parent="1" source="s_vp" target="s_vp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="540"/><mxPoint x="560" y="540"/></Array></mxGeometry></mxCell><mxCell id="e16" value="ventana [verificado]" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=1;exitY=0.9;entryX=0.25;entryY=0;" edge="1" parent="1" source="s_vp" target="s_ver"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="460"/></Array></mxGeometry></mxCell><mxCell id="e17" value="ventana [verificación fallida]" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0;exitY=0.9;entryX=0.75;entryY=0;" edge="1" parent="1" source="s_vp" target="s_rch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="460"/></Array></mxGeometry></mxCell><mxCell id="e18" value="declaracionesDecididas" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s_ver" target="s_res"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="notificado" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s_rch" target="fin1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="notificado" style="endArrow=open;endSize=10;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#3B4B5C;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontColor=#1F2A36;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s_res" target="fin2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="&lt;b&gt;ADR-004 · «transaction».&lt;/b&gt; Archivo, llave y acuse se confirman juntos (commit) o nada (rollback). Una llave repetida es un duplicado." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="1060" y="130" width="400" height="70" as="geometry"/></mxCell><mxCell id="e22" value="" style="endArrow=none;dashed=1;dashPattern=4 3;strokeColor=#7A8794;html=1;rounded=0;" edge="1" parent="1" source="n21" target="s_rec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="&lt;b&gt;ADR-007.&lt;/b&gt; Con la ECD caída y la caché vencida, el archivo queda acusado pero sin resultado. El reprocesador lo reverifica en cada ventana; al agotar los días se notifica y sigue pendiente, nunca se acepta sin verificar." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="1060" y="380" width="400" height="90" as="geometry"/></mxCell><mxCell id="e24" value="" style="endArrow=none;dashed=1;dashPattern=4 3;strokeColor=#7A8794;html=1;rounded=0;" edge="1" parent="1" source="n23" target="s_vp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n25" value="&lt;b&gt;ASR-S06 · {authenticity}.&lt;/b&gt; A Resuelto solo se llega por Verificado, y a Verificado solo con firma, firmante, cadena, estampa y revocación verificadas." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="1060" y="820" width="400" height="80" as="geometry"/></mxCell><mxCell id="e26" value="" style="endArrow=none;dashed=1;dashPattern=4 3;strokeColor=#7A8794;html=1;rounded=0;" edge="1" parent="1" source="n25" target="s_res"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n27" value="&lt;b&gt;[PREGUNTA → BCR]&lt;/b&gt; maxAttempts = días de reintento; hora de la ventana." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FAFAF7;strokeColor=#A0AAB4;align=left;verticalAlign=top;spacingLeft=6;spacingRight=12;spacingTop=2;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="1060" y="920" width="400" height="56" as="geometry"/></mxCell><mxCell id="lg28" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;▢ estado (nombre / actividades entry, do) · ● estado inicial · ◉ estado final&lt;br&gt;transición: evento [guarda] / acción · ventana = evento de la ventana nocturna de reproceso&lt;br&gt;nota: decisión (ADR), restricción {…} o dato pendiente [PREGUNTA]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#A0AAB4;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="560" height="81" as="geometry"/></mxCell><mxCell id="cv29" value="&lt;b&gt;Convención ASR&lt;/b&gt; · cada elemento lleva la insignia de los ASR en cuyo alcance está" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#A0AAB4;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="1207" width="560" height="122" as="geometry"/></mxCell><mxCell id="b30" value="ASR-S06" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#5B3A8C;strokeColor=#5B3A8C;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="1237" width="54" height="17" as="geometry"/></mxCell><mxCell id="t31" value="Ningún archivo se acepta sin validación criptográfica completa" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="114" y="1235" width="470" height="20" as="geometry"/></mxCell><mxCell id="b32" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="1261" width="54" height="17" as="geometry"/></mxCell><mxCell id="t33" value="Ningún archivo se rechaza por la caída de un sistema externo (foco)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="114" y="1259" width="470" height="20" as="geometry"/></mxCell><mxCell id="b34" value="ASR-D01" 
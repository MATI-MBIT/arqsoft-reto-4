ntStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=#5B3A8C;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#5B3A8C;" vertex="1" parent="1"><mxGeometry x="68" y="81" width="54" height="17" as="geometry"/></mxCell><mxCell id="b76" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="1328" y="321" width="54" height="17" as="geometry"/></mxCell><mxCell id="b77" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="68" y="591" width="54" height="17" as="geometry"/></mxCell><mxCell id="b78" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="908" y="871" width="54" height="17" as="geometry"/></mxCell><mxCell id="lg79" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;clase UML con compartimentos de nombre y atributos · «enumeration»: valores permitidos&lt;br&gt;◆— composición: la parte vive y muere con el todo · —▷ generalización · ▸ dirección de lectura&lt;br&gt;«canonical»: modelo canónico al que traducen los adaptadores de DG-CMP-003&lt;br&gt;nota: decisión (ADR) o restricción {…} · [PREGUNTA] / [SUPUESTO]: dato por confirmar" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#A0AAB4;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="560" height="96" as="geometry"/></mxCell><mxCell id="cv80" value="&lt;b&gt;Convención ASR&lt;/b&gt; · cada elemento lleva la insignia de los ASR en cuyo alcance está" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#A0AAB4;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="1262" width="560" height="146" as="geometry"/></mxCell><mxCell id="b81" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="1292" width="54" height="17" as="geometry"/></mxCell><mxCell id="t82" value="Ningún archivo se rechaza por la caída de un sistema externo (foco)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="114" y="1290" width="470" height="20" as="geometry"/></mxCell><mxCell id="b83" value="ASR-L04" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#2E7D6E;strokeColor=#2E7D6E;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="1316" width="54" height="17" as="geometry"/></mxCell><mxCell id="t84" value="Aislamiento de carga entre archivos masivos y pequeños" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="114" y="1314" width="470" height="20" as="geometry"/></mxCell><mxCell id="b85" value="ASR-S06" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#5B3A8C;strokeColor=#5B3A8C;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="1340" width="54" height="17" as="geometry"/></mxCell><mxCell id="t86" value="Ningún archivo se acepta sin validación criptográfica completa" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="114" y="1338" width="470" height="20" as="geometry"/></mxCell><mxCell id="b87" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="1370" width="54" height="17" as="geometry"/></mxCell><mxCell id="t88" value="relleno: artefacto del ASR" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="114" y="1368" width="180" height="20" as="geometry"/></mxCell><mxCell id="b89" value="ASR-D01" style="rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="310" y="1370" width="54" height="17" as="geometry"/></mxCell><mxCell id="t90" value="contorno punteado: participa sin modificarse" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="372" y="1368" width="230" height="20" as="geometry"/></mxCell><mxCell id="tz91" value="&lt;b&gt;Trazabilidad ASR → elementos de la arquitectura&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(★ crítico)&lt;/font&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;margin-top:6px;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;ASR&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Atributo&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Artefacto (relleno)&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Participa sin modificarse&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Táctica principal&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Medida&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#1F4E79;color:#FFFFFF;font-weight:bold;padding:1px 6px;border-radius:4px&quot;&gt;ASR-D01&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Disponibilidad · recuperación&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;DeclaracionPendiente · DatoTercero · ResultadoDeclaracion · LlaveArchivo · Notificacion · Archivo&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Declaracion · Acuse · EstadoTercero&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Pendientes durables y ventana nocturna · llave de idempotencia&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;100 % de los archivos válidos procesados dentro de los días de reintento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#2E7D6E;color:#FFFFFF;font-weight:bold;padding:1px 6px;border-radius:4px&quot;&gt;ASR-L04&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Latencia&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;— (el aislamiento es de procesamiento, no de datos)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Archivo (carril)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Dos carriles aislados con enrutador por tamaño&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;p99 ≤ 3 s por archivo pequeño con 5 masivos en proceso&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#5B3A8C;color:#FFFFFF;font-weight:bold;padding:1px 6px;border-radius:4px&quot;&gt;ASR-S06&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Seguridad · prevención&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;VerificacionCriptografica · CertificadoFirmante&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Archivo · EntradaEvidencia · ResultadoDefinitivo&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Verificación completa con resultado retenido&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;0 archivos aceptados sin firma, firmante, cadena, estampa y revocación verificadas&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#A0AAB4;fontSize=12;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="640" y="1150" width="1990" height="216" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dg-per-001" name="DG-PER-001 · Persistencia"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Reto 4 — Orquídea · Vista de Información : Modelo de Persistencia (DG-PER-001)&lt;/b&gt;&lt;br&gt;Dónde vive cada dato, quién es su propietario y qué componente de DG-CMP-003 lo escribe o lo lee." style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="700" y="10" width="1300" height="50" as="geometry"/></mxCell><mxCell id="d_rec" value="&lt;b&gt;Recepción y verificación&lt;/b&gt;" style="rounded=1;arcSize=3;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#9AA3AE;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="400" height="640" as="geometry"/></mxCell><mxCell id="s_rec" value="&lt;b&gt;Recepción&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;custodia el archivo · registra llave y acuse&lt;br&gt;anexa la evidencia&lt;br&gt;publica en el tópico de su carril&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B4B5C;strokeWidth=1.3;fontSize=12;spacingRight=24;spacingLeft=6;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="340" height="100" as="geometry"/></mxCell><mxCell id="s_rec_i" value="" style="shape=component;jettyWidth=8;jettyHeight=4;html=1;fillColor=#FFFFFF;strokeColor=#3B4B5C;" vertex="1" parent="s_rec"><mxGeometry x="310" y="8" width="20" height="18" as="geometry"/></mxCell><mxCell id="s_ver" value="&lt;b&gt;Verificador criptográfico&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quo
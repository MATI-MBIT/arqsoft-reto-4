t-align:left&quot;&gt;Táctica principal&lt;/th&gt;&lt;th style=&quot;border-bottom:1px solid #1F2A36;padding:4px 8px;text-align:left&quot;&gt;Medida&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#5B3A8C;color:#FFFFFF;font-weight:bold;padding:1px 6px;border-radius:4px&quot;&gt;ASR-S06&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Seguridad · prevención&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;VerificacionPendiente · Verificado&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Recibido · Resuelto · Rechazado&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Verificación completa con resultado retenido (ADR-006, ADR-007)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;0 archivos aceptados sin firma, firmante, cadena, estampa y revocación verificadas&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#1F4E79;color:#FFFFFF;font-weight:bold;padding:1px 6px;border-radius:4px&quot;&gt;ASR-D01&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Disponibilidad · recuperación&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;VerificacionPendiente&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Recibido&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;Pendientes durables y ventana nocturna (ADR-003)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #DDE2E7;padding:4px 8px;vertical-align:top&quot;&gt;100 % de los archivos válidos procesados dentro de los días de reintento&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#A0AAB4;fontSize=12;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="640" y="1110" width="840" height="164" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dg-stm-002" name="DG-STM-002 · Ciclo de vida de la declaración"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f1" value="&lt;b&gt;stm&lt;/b&gt; DG-STM-002 · Declaracion: enriquecimiento y reintento diferido a la ventana nocturna" style="shape=umlFrame;whiteSpace=wrap;html=1;width=620;height=30;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#3B4B5C;strokeWidth=1.4;fontSize=14;fontFamily=Helvetica;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1560" height="1180" as="geometry"/></mxCell><mxCell id="t2" value="máquina de estados UML · contexto: clase Declaracion, atributo estado : EstadoDeclaracion (DG-CLS-001) · ASR-D01 · ADR-003, ADR-004" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="660" y="26" width="900" height="20" as="geometry"/></mxCell><mxCell id="i" value="" style="ellipse;html=1;fillColor=#1F2A36;strokeColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="157" y="80" width="26" height="26" as="geometry"/></mxCell><mxCell id="s_enr" value="&lt;b&gt;EnEnriquecimiento&lt;/b&gt;&lt;hr style=&quot;border:none;border-top:1px solid #3B4B5C;margin:6px -8px 4px&qu
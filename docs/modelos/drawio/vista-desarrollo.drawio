<mxfile host="diagramar-uml-arquitectura"><diagram id="dg-cst-003" name="DG-CST-003 · Configuración versionada (caja blanca)"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="&lt;b&gt;DG-CST-003&lt;/b&gt; · Caja blanca de Configuración versionada (N1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1239.9" height="24" as="geometry"/></mxCell><mxCell id="titulo__meta" value="caja blanca · refina: Configuración versionada · ASR ASR-M01 · ADR ADR-008, ADR-009" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="1239.9" height="14" as="geometry"/></mxCell><mxCell id="cfg" value="«component»&lt;br&gt;&lt;b&gt;Configuración versionada&lt;/b&gt;" style="html=1;whiteSpace=wrap;verticalAlign=top;align=center;spacingTop=6;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#2B3642;fila=C4;" vertex="1" parent="1"><mxGeometry x="40" y="144" width="1239.9" height="461" as="geometry"/></mxCell><mxCell id="cfg__ico" value="" style="shape=module;jettyWidth=8;jettyHeight=4;fillColor=#FFFFFF;strokeColor=#2B3642;" vertex="1" parent="cfg"><mxGeometry x="1211.9" y="8" width="20" height="20" as="geometry"/></mxCell><mxCell id="conf" value="«control»&lt;br&gt;configurator : ValidadorDeReglas&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;«tactic» {id = MOD-09, variante = despliegue}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFF4D6;strokeColor=#B8860B;fila=C1;" vertex="1" parent="cfg"><mxGeometry x="264.9" y="101" width="252.2" height="64" as="geometry"/></mxCell><mxCell id="banco" value="«control»&lt;br&gt;banco : BancoDePruebas" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="cfg"><mxGeometry x="50.3" y="232" width="166.1" height="50.8" as="geometry"/></mxCell><mxCell id="conm" value="«control»&lt;br&gt;conmutador : ConmutadorDeVersion&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;«tactic» {id = MOD-12}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{cambio atómico de la versión vigente}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="cfg"><mxGeometry x="608.8" y="222" width="225.4" height="77.2" as="geometry"/></mxCell><mxCell id="cat" value="«entity»&lt;br&gt;configuration : CatalogoDeReglas&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{binding = despliegue}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFF4D6;strokeColor=#B8860B;fila=C1;" vertex="1" parent="cfg"><mxGeometry x="774.8" y="369.6" width="209.2" height="64" as="geometry"/></mxCell><mxCell id="xsd" value="«entity»&lt;br&gt;esquemas : RegistroDeEsquemas" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#2B3642;fila=C4;" vertex="1" parent="cfg"><mxGeometry x="1004" y="369.6" width="211.9" height="50.8" as="geometry"/></mxCell><mxCell id="fij" value="«control»&lt;br&gt;fijador : FijadorDeVersion" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="cfg"><mxGeometry x="1000.1" y="236.3" width="164.7" height="50.8" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Reglas como datos&lt;/b&gt;: ADR-008: una regla&lt;br&gt;sobre datos que ya llegan es un registro&lt;br&gt;nuevo del catálogo, sin compilar. Precio: lo&lt;br&gt;que el lenguaje no exprese sale de las 4 h" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="cfg"><mxGeometry x="527.6" y="366.2" width="237.2" height="70.8" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Activar = revertir&lt;/b&gt;: ADR-009: los&lt;br&gt;dos cambian la versión&lt;br&gt;vigente; los archivos en&lt;br&gt;curso siguen con la suya" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="cfg"><mxGeometry x="411.9" y="225.2" width="186.9" height="70.8" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;R-8&lt;/b&gt;: Se aplica la regla&lt;br&gt;vigente a la hora de&lt;br&gt;recepción del archivo,&lt;br&gt;no a la hora de validar" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="cfg"><mxGeometry x="854.2" y="226.3" width="135.9" height="70.8" as="geometry"/></mxCell><mxCell id="iAct" value="IActivacion" style="ellipse;html=1;fontSize=11;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="420.9" y="76" width="20" height="20" as="geometry"/></mxCell><mxCell id="iVer" value="IVersionVigente" style="ellipse;html=1;fontSize=11;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="1112.5" y="76" width="20" height="20" as="geometry"/></mxCell><mxCell id="pAct" value="pActivacion" style="html=1;labelPosition=left;verticalLabelPosition=top;align=right;verticalAlign=bottom;fontSize=11;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;" vertex="1" parent="1"><mxGeometry x="422.9" y="136" width="16" height="16" as="geometry"/></mxCell><mxCell id="pVer" value="pVersion" style="html=1;labelPosition=left;verticalLabelPosition=top;align=right;verticalAlign=bottom;fontSize=11;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;" vertex="1" parent="1"><mxGeometry x="1114.5" y="136" width="16" height="16" as="geometry"/></mxCell><mxCell id="r0" value="" style="endArrow=none;html=1;rounded=0;fontSi
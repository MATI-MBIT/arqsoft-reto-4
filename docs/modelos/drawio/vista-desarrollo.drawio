unded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#9A5B13;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#9A5B13;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="motor"><mxGeometry x="8" y="-10" width="55" height="18" as="geometry"/></mxCell><mxCell id="cat__asr3" value="ASR-M01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#9A5B13;strokeColor=#9A5B13;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="cat"><mxGeometry x="8" y="-10" width="55" height="18" as="geometry"/></mxCell><mxCell id="regla__asr3" value="ASR-M01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#9A5B13;strokeColor=#9A5B13;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="regla"><mxGeometry x="8" y="-10" width="55" height="18" as="geometry"/></mxCell><mxCell id="leyenda__lg" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;relleno ámbar: artefacto de un ASR (ahí se aplica la táctica o se hace el cambio)&lt;br&gt;borde ámbar: participa en la respuesta, pero no se modifica&lt;br&gt;blanco: fuera del alcance de los ASR de esta página&lt;br&gt;nota: la decisión, atada con punteada a su elemento" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=42;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40" y="1113" width="560" height="78" as="geometry"/></mxCell><mxCell id="leyenda__lg__m0" value="" style="text;html=1;fillColor=#FFF4D6;strokeColor=#B8860B;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="22.2" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m1" value="" style="text;html=1;fill
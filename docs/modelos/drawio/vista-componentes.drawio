        <mxCell id="r_rcp__asr0" connectable="0" parent="r_rcp" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" value="ASR-D01" vertex="1">

;spacing=0;" vertex="1" connectable="0" parent="i_fb"><mxGeometry x="8" y="-10" width="54" height="18" as="geometry"/></mxCell><mxCell id="leyenda__lg" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;relleno ámbar: artefacto de un ASR (ahí se aplica la táctica o se hace el cambio)&lt;br&gt;borde ámbar: participa en la respuesta, pero no se modifica&lt;br&gt;blanco: fuera del alcance de los ASR de esta página&lt;br&gt;carpeta o marco gris: agrupa, no es un elemento&lt;br&gt;azul: punto de contacto (interfaz, puerto o evento)&lt;br&gt;nota: la decisión, atada con punteada a su elemento&lt;br&gt;□ sobre el borde: puerto, con su interfaz junto a él&lt;br&gt;elipse punteada: la táctica aplicada, atada con punteadas sin flecha a los roles que liga&lt;br&gt;«tactic» {id = …}: el elemento aplica esa táctica del catálogo" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=42;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40" y="700.8" width="560" height="148" as="geometry"/></mxCell><mxCell id="leyenda__lg__m0" value="" style="text;html=1;fillColor=#FFF4D6;strokeColor=#B8860B;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="22.2" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m1" value="" style="text;html=1;fillColor=#FFFFFF;strokeColor=#B8860B;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="35.4" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m2" value="" style="text;html=1;fillColor=#FFFFFF;strokeColor=#2B3642;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="48.6" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m3" value="" style="text;html=1;fillColor=none;strokeColor=#7A8794;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="61.8" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m4" value="" style="text;html=1;fillColor=#E8F0FA;strokeColor=#3D6A9E;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="75" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m5" value="" style="text;html=1;fillColor=#FFFDE7;strokeColor=#9A8B4F;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="88.2" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__cv" value="&lt;b&gt;Convención ASR&lt;/b&gt; · cada elemento lleva la insignia de los ASR en cuyo alcance está" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40" y="866.8" width="560" height="130" as="geometry"/></mxCell><mxCell id="leyenda__cv__b0" value="ASR-D01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="27" width="54" height="18" as="geometry"/></mxCell><mxCell id="leyenda__cv__t0" value="Ningún archivo se rechaza por la caída&lt;br&gt;de un externo" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="72" y="26" width="207" height="34" as="geometry"/></mxCell><mxCell id="leyenda__cv__fa" value="ASR-D01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="77" width="54" height="18" as="geometry"/></mxCell><mxCell id="leyenda__cv__fat" value="&lt;b&gt;relleno&lt;/b&gt;: artefacto del ASR (ahí se aplica la táctica o se hace el cambio)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="72" y="76" width="500" height="20" as="geometry"/></mxCell><mxCell id="leyenda__cv__fp" value="ASR-D01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="101" width="54" height="18" as="geometry"/></mxCell><mxCell id="leyenda__cv__fpt" value="&lt;b&gt;contorno punteado&lt;/b&gt;: participa en la respuesta, pero no se modifica" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="72" y="100" width="500" height="20" as="geometry"/></mxCell><mxCell id="leyenda__traz" value="&lt;b style=&quot;font-size:13px&quot;&gt;Trazabilidad ASR → elementos de la arquitectura&lt;/b&gt; &amp;nbsp;(★ priorizado)&lt;table style=&quot;border-collapse:collapse;table-layout:fixed;width:1120px;margin-top:6px;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:73px&quot;&gt;ASR&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:98px&quot;&gt;Atributo&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:263px&quot;&gt;Alcance · artefacto (relleno)&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:208px&quot;&gt;Participa sin modificarse (contorno)&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:208px&quot;&gt;Táctica principal&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:198px&quot;&gt;Medida&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top;white-space:nowrap&quot;&gt;&lt;span style=&quot;background:#1F4E79;color:#fff;font-weight:bold;padding:1px 5px;border-radius:4px&quot;&gt;ASR-D01&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Disponibilidad · recuperación&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;degradationController : ControlDegradacion · exceptionNotifier : TemporizadorConsulta · fallback : PublicadorPendientes&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;essentialFunction : OrquestadorEnriquecimiento · serviceMode : EstadoTerceros&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Monitor, pendientes durables y ventana nocturna&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;100 % de los archivos válidos procesados dentro de los días de reintento&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="630" y="700.8" width="1150" height="108" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dg-cst-003" name="DG-CST-003 · Verificador criptográfico (caja blanca)"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="&lt;b&gt;DG-CST-003&lt;/b&gt; · Caja blanca del Verificador criptográfico: firma, cadena, estampa y revocación" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1159.2" height="24" as="geometry"/></mxCell><mxCell id="titulo__meta" value="caja blanca · refina: Verificador criptográfico · ASR ASR-S06, ASR-D01 · ADR ADR-006, ADR-007" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="1159.2" height="14" as="geometry"/></mxCell><mxCell id="c_ver" value="«component»&lt;br&gt;&lt;b&gt;Verificador criptográfico&lt;/b&gt;" style="html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingTop=6;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#2B3642;fila=C4;spacingLeft=488.1;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="1159.2" height="735.8" as="geometry"/></mxCell><mxCell id="c_ver__ico" value="" style="shape=module;jettyWidth=8;jettyHeight=4;fillColor=#FFFFFF;strokeColor=#2B3642;" vertex="1" parent="c_ver"><mxGeometry x="1131.2" y="8" width="20" height="20" as="geometry"/></mxCell><mxCell id="v_par" value="«boundary»&lt;br&gt;parser : ParserStreaming&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;«tactic» {id = SEG-08}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{sin DTD ni entidades externas}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFF4D6;strokeColor=#B8860B;fila=C1;" vertex="1" parent="c_ver"><mxGeometry x="552.8" y="101" width="184.2" height="77.2" as="geometry"/></mxCell><mxCell id="v_res" value="«control»&lt;br&gt;resumen : ResumenFirmado&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;«tactic» {id = SEG-11}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{mismos bytes custodiados}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFF4D6;strokeColor=#B8860B;fila=C1;" vertex="1" parent="c_ver"><mxGeometry x="554.1" y="235.2" width="181.6" height="77.2" as="geometry"/></mxCell><mxCell id="v_aut" value="«control»&lt;br&gt;authenticator : VerificadorFirma&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;«tactic» {id = SEG-02, variante = un-factor}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{authenticity}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFF4D6;strokeColor=#B8860B;fila=C1;" vertex="1" parent="c_ver"><mxGeometry x="485" y="369.4" width="239.8" height="77.2" as="geometry"/></mxCell><mxCell id="v_poi" value="«entity»&lt;br&gt;proofOfIdentity : CertificadoFirmante" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="c_ver"><mxGeometry x="343.1" y="503.6" width="223.3" height="50.8" as="geometry"/></mxCell><mxCell id="v_dc" value="«control»&lt;br&gt;degradationController : ControlRevocacion&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;«tactic» {id = DIS-14, variante = fallback}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFF4D6;strokeColor=#B8860B;fila=C1;" vertex="1" parent="c_ver"><mxGeometry x="778.6" y="503.6" width="257" height="64" as="geometry"/></mxCell><mxCell id="v_ai" value="«entity»&lt;br&gt;authenticationInformation : CacheRevocacion&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;«tactic» {id = LAT-10}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{refresco = TBD}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="c_ver"><mxGeometry x="234.7" y="634.6" width="272.5" height="77.2" as="geometry"/></mxCell><mxCell id="v_fb" value="«control»&lt;br&gt;fallback : MarcaVerificacionPendiente" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="c_ver"><mxGeometry x="856.3" y="647.8" width="230.1" height="50.8" as="geometry"/></mxCell><mxCell id="v_cu" value="DIS-14 : Graceful Degradation" style="el
 2;fontColor=#5B3F8C;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="c_rec"><mxGeometry x="123" y="-10" width="53" height="18" as="geometry"/></mxCell><mxCell id="c_ver__asr2" value="ASR-S06" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#5B3F8C;strokeColor=#5B3F8C;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="c_ver"><mxGeometry x="8" y="-10" width="53" height="18" as="geometry"/></mxCell><mxCell id="c_res__asr0" value="ASR-D01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="c_res"><mxGeometry x="8" y="-10" width="54" height="18" as="geometry"/></mxCell><mxCell id="c_res__asr2" value="ASR-S06" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#5B3F8C;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#5B3F8C;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="c_res"><mxGeometry x="66" y="-10" width="53" height="18" as="geometry"/></mxCell><mxCell id="leyenda__lg" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;relleno ámbar: artefacto de un ASR (ahí se aplica la táctica o se hace el cambio)&lt;br&gt;borde ámbar: participa en la respuesta, pero no se modifica&lt;br&gt;blanco: fuera del alcance de los ASR de esta página&lt;br&gt;gris: sistema fuera de nuestro control&lt;br&gt;marco: la frontera del sistema&lt;br&gt;carpeta o marco gris: agrupa, no es un elemento&lt;br&gt;azul: punto de contacto (interfaz, puerto o evento)&lt;br&gt;nota: la decisión, atada con punteada a su elemento&lt;br&gt;—○ la bola: interfaz que el componente &lt;b&gt;provee&lt;/b&gt;&lt;br&gt;bola dentro del semicírculo: ensamble entre quien &lt;b&gt;provee&lt;/b&gt; la interfaz y quien la &lt;b&gt;requiere&lt;/b&gt;&lt;br&gt;«external»: sistema fuera de nuestro control&lt;br&gt;«subsystem»: la frontera del sistema; fuera de ella, los externos y los actores&lt;br&gt;«tactic» {id = …}: el elemento aplica esa táctica del catálogo" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=42;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40" y="1496.2" width="560" height="204" as="geometry"/></mxCell><mxCell id="leyenda__lg__m0" value="" style="text;html=1;fillColor=#FFF4D6;strokeColor=#B8860B;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="22.2" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m1" value="" style="text;html=1;fillColor=#FFFFFF;strokeColor=#B8860B;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="35.4" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m2" value="" style="text;html=1;fillColor=#FFFFFF;strokeColor=#2B3642;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="48.6" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m3" value="" style="text;html=1;fillColor=#F2F2F2;strokeColor=#7A8794;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="61.8" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m4" value="" style="text;html=1;fillColor=none;strokeColor=#2B3642;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="75" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m5" value="" style="text;html=1;fillColor=none;strokeColor=#7A8794;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="88.2" width="24" height="14" as="geometry"/></mxCell><mxCe
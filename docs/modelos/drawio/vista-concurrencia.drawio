        <mxCell id="m14" value="acuse | acuse de custodia" style="html=1;verticalAlign=bottom;dashed=1;endArrow=open;endSize=8;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2B3642;fontColor=#1F2A36;exitX=0;exitY=0.9842;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.9174;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s_rcp__act0" target="s_rem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nq2" value="&lt;b&gt;ADR-006&lt;/b&gt;: verificado: acuse;&lt;br&gt;pendiente o sin terminar: acuse de&lt;br&gt;custodia, sin resultado definitivo&lt;br&gt;hasta verificar (ASR-S06)" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="1">
          <mxGeometry x="436.8" y="1012" width="196.4" height="70.8" as="geometry" />
        </mxCell>
        <mxCell id="nq2__a0" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9A8B4F;dashPattern=2 3;" edge="1" parent="1" source="nq2" target="s_ver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nq1" value="&lt;b&gt;Medida&lt;/b&gt;: t0 = último byte. El acuse no&lt;br&gt;espera a terceros ni al carril (ASR-D01);&lt;br&gt;el p99 ≤ 3 s del pequeño corre de t0 al&lt;br&gt;resultado en el carril A (ASR-L04)" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="1">
          <mxGeometry x="1746.2" y="284" width="223.6" height="70.8" as="geometry" />
        </mxCell>
        <mxCell id="nq1__a0" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9A8B4F;dashPattern=2 3;" edge="1" parent="1" source="nq1" target="fv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fp" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=60;height=20;fontSize=11;fillColor=none;strokeColor=#5A6B7D;fila=C13;" vertex="1" parent="1">
          <mxGeometry x="300" y="752" width="1405" height="148" as="geometry" />
        </mxCell>
        <mxCell id="fp__g0" value="[verificado]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="fp">
          <mxGeometry x="66" y="0" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="fp__sep1" value="" style="line;strokeWidth=1;dashed=1;html=1;strokeColor=#2B3642;" vertex="1" parent="fp">
          <mxGeometry x="0" y="98" width="1405" height="10" as="geometry" />
        </mxCell>
        <mxCell id="fp__g1" value="[pendiente]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="fp">
          <mxGeometry x="66" y="106" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="nq3" value="&lt;b&gt;ADR-007&lt;/b&gt;: pendiente no anexa&lt;br&gt;evidencia ni pasa a un carril: va&lt;br&gt;al tópico pendientes, el mismo de&lt;br&gt;los terceros, con su motivo. El&lt;br&gt;reprocesador lo reverifica de noche" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="1">
          <mxGeometry x="1746.2" y="752" width="223.6" height="84" as="geometry" />
        </mxCell>
        <mxCell id="nq3__a0" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9A8B4F;dashPattern=2 3;" edge="1" parent="1" source="nq3" target="fp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nq4" value="&lt;b&gt;Claim Check&lt;/b&gt; (ESC-05): el archivo queda en la custodia con el commit; el publicador manda solo la ficha (llave, ruta en la custodia, tamaño, registros, carril). El carril o el reprocesador traen los bytes con la ruta" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;whiteSpace=wrap;" vertex="1" parent="1">

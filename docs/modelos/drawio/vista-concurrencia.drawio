        <mxCell id="nk1" value="&lt;b&gt;Medida ASR-D01&lt;/b&gt;: 100 % de los archivos válidos&lt;br&gt;procesados dentro de los días de&lt;br&gt;reintento: aquí ninguna declaración se&lt;br&gt;rechaza por la caída; timeout ≤ TBD" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="1">

          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nc2" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;shape=note;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;" value="&lt;b&gt;ADR-005 · bulkhead&lt;/b&gt;: cada carril con su tópico, su pool y su CPU: un masivo nunca ocupa un hilo del carril A. Precio: dos pools que dimensionar" vertex="1">
          <mxGeometry height="85" width="240" x="640" y="95" as="geometry" />

        <mxCell id="nc1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;shape=note;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;" value="&lt;b&gt;Se sincroniza&lt;/b&gt;: el resultado de cada declaración. Carriles y reprocesador compiten; la unicidad por (archivo, declaración) deja escribir solo al primero (ADR-004)" vertex="1">

        <mxCell id="num5_o_qb" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="5" vertex="1">
          <mxGeometry height="26" width="26" x="686" y="458" as="geometry" />
        </mxCell>
        <mxCell id="num6_o_pa" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="6" vertex="1">
          <mxGeometry height="26" width="26" x="1026" y="183" as="geometry" />

        <mxCell id="num6_o_pb" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="6" vertex="1">
          <mxGeometry height="26" width="26" x="1026" y="433" as="geometry" />
        </mxCell>
        <mxCell id="num7_o_ter" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="7" vertex="1">
          <mxGeometry height="26" width="26" x="1746" y="318" as="geometry" />
        </mxCell>
        <mxCell id="num8_o_mo" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="8" vertex="1">
          <mxGeometry height="26" width="26" x="1746" y="73" as="geometry" />
        </mxCell>
        <mxCell id="num9_o_qe" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="9" vertex="1">
          <mxGeometry height="26" width="26" x="1306" y="83" as="geometry" />
        </mxCell>
        <mxCell id="num10_o_qp" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="10" vertex="1">
          <mxGeometry height="26" width="26" x="1306" y="748" as="geometry" />
        </mxCell>
        <mxCell id="num11_o_rp" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="11" vertex="1">
          <mxGeometry height="26" width="26" x="1446" y="928" as="geometry" />
        </mxCell>
        <mxCell id="num12_o_rs" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="12" vertex="1">
          <mxGeometry height="26" width="26" x="1026" y="748" as="geometry" />
        </mxCell>
        <mxCell id="panel_tit" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" value="¿Para qué sirve cada pieza? (el número coincide con el círculo de cada elemento)" vertex="1">
          <mxGeometry height="30" width="1400" x="20" y="1510" as="geometry" />
        </mxCell>
        <mxCell id="card1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=6;spacingRight=6;fontSize=11;" value="&lt;b&gt;Remitente&lt;/b&gt;&lt;br&gt;El IMC o el titular de cuenta de compensación. Sube el archivo XML firmado por HTTPS (1) y en la misma respuesta recibe el acuse, el acuse de custodia o el rechazo con su causa (1.6). El resultado definitivo le llega después." vertex="1">
          <mxGeometry height="128" width="665" x="20" y="1550" as="geometry" />
        </mxCell>
        <mxCell id="card1_n" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="1" vertex="1">
          <mxGeometry height="24" width="24" x="26" y="1558" as="geometry" />
        </mxCell>
        <mxCell id="card2" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=6;spacingRight=6;fontSize=11;" value="&lt;b&gt;recepcion : Recepción&lt;/b&gt;&lt;br&gt;La puerta única. Lee el archivo una sola vez mientras llega: lo custodia, calcula su hash y verifica firma, firmante, cadena, estampa y revocación antes de acusar (ADR-006). Registra la llave con el archivo en una sola transacción (1.2: llave repetida = 409), anexa la evidencia (1.3) y publica en el carril según el tamaño en bytes (1.4). No espera a los terceros ni al carril (ADR-001)." vertex="1">
          <mxGeometry height="128" width="665" x="700" y="1550" as="geometry" />
        </mxCell>
        <mxCell id="card2_n" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="2" vertex="1">
          <mxGeometry height="24" width="24" x="706" y="1558" as="geometry" />
        </mxCell>
        <mxCell id="card3" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=6;spacingRight=6;fontSize=11;" value="&lt;b&gt;evidencia : RegistroDeEvidencia&lt;/b&gt;&lt;br&gt;Una entrada por archivo verificado, con hash, certificado y estampa, firmada por BCR y en un registro de solo anexar (ADR-008). Es la prueba de qué llegó y cómo se verificó." vertex="1">
          <mxGeometry height="128" width="665" x="1380" y="1550" as="geometry" />
        </mxCell>
        <mxCell id="card3_n" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="3" vertex="1">
          <mxGeometry height="24" width="24" x="1386" y="1558" as="geometry" />
        </mxCell>
        <mxCell id="card4" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=6;spacingRight=6;fontSize=11;" value="&lt;b&gt;ecd : ECD&lt;/b&gt;&lt;br&gt;La entidad de certificación digital: publica la lista de certificados revocados. La recepción solo la consulta si su caché de revocación está vencida (1.1, ADR-007). Si está caída, el archivo queda en verificación pendiente, nunca se acepta sin verificar (S06)." vertex="1">
          <mxGeometry height="128" width="665" x="20" y="1690" as="geometry" />
        </mxCell>
        <mxCell id="card4_n" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="4" vertex="1">
          <mxGeometry height="24" width="24" x="26" y="1698" as="geometry" />
        </mxCell>
        <mxCell id="card5" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=6;spacingRight=6;fontSize=11;" value="&lt;b&gt;carril-a y carril-b&lt;/b&gt;&lt;br&gt;Separan pequeños de masivos desde la recepción (L04). No llevan el archivo sino su ficha (patrón Claim Check): llave, ruta en la custodia, tamaño, registros y carril. El worker trae los bytes de la custodia con la ruta. Son durables: si un worker cae, el mensaje sigue ahí y se le entrega de nuevo." vertex="1">
          <mxGeometry height="128" width="665" x="700" y="1690" as="geometry" />
        </mxCell>
        <mxCell id="card5_n" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="5" vertex="1">
          <mxGeometry height="24" width="24" x="706" y="1698" as="geometry" />
        </mxCell>
        <mxCell id="card6" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=6;spacingRight=6;fontSize=11;" value="&lt;b&gt;workerA y workerB&lt;/b&gt;&lt;br&gt;Los procesadores de cada carril, en procesos separados con su propio pool (ADR-005). Toman el archivo (1), miran que los cuatro terceros estén disponibles (2) y consultan a los cuatro en serie, cada llamada con su timeout (3). El orquestador de enriquecimiento y los adaptadores no son un proceso aparte: cada worker tiene su propia copia, así un carril no le quita recursos al otro, y escriben el resultado una sola vez (4; el B, por lotes). Si alguno está caído o una llamada vence, la declaración entera queda pendiente (5), nunca rechazada, y después se consulta a los cuatro de nuevo: los datos de los externos pueden cambiar por decisión del gobierno." vertex="1">
          <mxGeometry height="128" width="665" x="1380" y="1690" as="geometry" />
        </mxCell>
        <mxCell id="card6_n" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="6" vertex="1">
          <mxGeometry height="24" width="24" x="1386" y="1698" as="geometry" />
        </mxCell>
        <mxCell id="card7" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=6;spacingRight=6;fontSize=11;" value="&lt;b&gt;terceros : SistemaExterno&lt;/b&gt;&lt;br&gt;STM (tasas), ANTA (datos tributarios y aduaneros), MAMC (datos migratorios) y RNIC (identidad). Están fuera del control de BCR, no aceptan consultas por lote y se pueden caer por horas." vertex="1">
          <mxGeometry height="128" width="665" x="20" y="1830" as="geometry" />
        </mxCell>
        <mxCell id="card7_n" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="7" vertex="1">
          <mxGeometry height="24" width="24" x="26" y="1838" as="geometry" />
        </mxCell>
        <mxCell id="card8" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=6;spacingRight=6;fontSize=11;" value="&lt;b&gt;monitor : Monitor de terceros&lt;/b&gt;&lt;br&gt;Proceso propio que vigila a cada tercero con ping/echo (M1) y publica si está disponible, caído o de vuelta (M2, ADR-002). Una llamada vencida que reporta un worker cuenta como caída. Así nadie llama a un tercero que ya se sabe caído." vertex="1">
          <mxGeometry height="128" width="665" x="700" y="1830" as="geometry" />
        </mxCell>
        <mxCell id="card8_n" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="8" vertex="1">
          <mxGeometry height="24" width="24" x="706" y="1838" as="geometry" />
        </mxCell>
        <mxCell id="card9" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=6;spacingRight=6;fontSize=11;" value="&lt;b&gt;estado-terceros : Tópico&lt;/b&gt;&lt;br&gt;Lleva los cambios de estado de cada tercero. Lo leen los dos carriles antes de llamar (A2, B2) y el reprocesador antes de abrir la ventana (R1)." vertex="1">
          <mxGeometry height="128" width="665" x="1380" y="1830" as="geometry" />
        </mxCell>
        <mxCell id="card9_n" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="9" vertex="1">
          <mxGeometry height="24" width="24" x="1386" y="1838" as="geometry" />
        </mxCell>
        <mxCell id="card10" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=6;spacingRight=6;fontSize=11;" value="&lt;b&gt;pendientes : Tópico&lt;/b&gt;&lt;br&gt;Lo que no se pudo terminar, sin descartarlo: declaraciones con un tercero caído (A5, B5) y archivos con la verificación pendiente (1.5). El campo motivo los distingue. Es durable: nada se pierde mientras espera la noche." vertex="1">
          <mxGeometry height="128" width="665" x="20" y="1970" as="geometry" />
        </mxCell>
        <mxCell id="card10_n" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="10" vertex="1">
          <mxGeometry height="24" width="24" x="26" y="1978" as="geometry" />
        </mxCell>
        <mxCell id="card11" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=6;spacingRight=6;fontSize=11;" value="&lt;b&gt;reprocesador : Reprocesador nocturno&lt;/b&gt;&lt;br&gt;Corre en la ventana nocturna (ADR-003). Lee el estado de los terceros (R1) y los pendientes (R2). Por motivo: vuelve a consultar a los cuatro terceros, en serie y desde cero, con su propia copia del orquestador y los adaptadores (R3) o refresca la CRL y reverifica el archivo (R3). Escribe el resultado (R4) o publica el archivo verificado en su carril (R5). Si sigue caído, reprograma (R6); al agotar los días de reintento notifica, sin descartar." vertex="1">
          <mxGeometry height="128" width="665" x="700" y="1970" as="geometry" />
        </mxCell>
        <mxCell id="card11_n" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="11" vertex="1">
          <mxGeometry height="24" width="24" x="706" y="1978" as="geometry" />
        </mxCell>
        <mxCell id="card12" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=34;spacingTop=6;spacingRight=6;fontSize=11;" value="&lt;b&gt;repositorio : RepositorioDeArchivos&lt;/b&gt;&lt;br&gt;Archivos custodiados, llaves únicas, declaraciones, pendientes y resultados: la fuente de verdad duradera. Es el recurso que se sincroniza: recepción, carriles y reprocesador escriben aquí, y la unicidad por llave y por (archivo, declaración) evita duplicados y dobles escrituras." vertex="1">
          <mxGeometry height="128" width="665" x="1380" y="1970" as="geometry" />
        </mxCell>
        <mxCell id="card12_n" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#3B4B5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="12" vertex="1">

10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="115" width="53" height="18" as="geometry"/></mxCell><mxCell id="leyenda__cv__fat" value="&lt;b&gt;relleno&lt;/b&gt;: artefacto del ASR (ahí se aplica la táctica o se hace el cambio)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="71" y="114" width="500" height="20" as="geometry"/></mxCell><mxCell id="leyenda__cv__fp" value="ASR-L04" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="139" width="53" height="18" as="geometry"/></mxCell><mxCell id="leyenda__cv__fpt" value="&lt;b&gt;contorno punteado&lt;/b&gt;: participa en la respuesta, pero no se modifica" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="71" y="138" width="500" height="20" as="geometry"/></mxCell><mxCell id="leyenda__traz" value="&lt;b style=&quot;font-size:13px&quot;&gt;Trazabilidad ASR → elementos de la arquitectura&lt;/b&gt; &amp;nbsp;(★ priorizado)&lt;table style=&quot;border-collapse:collapse;table-layout:fixed;width:1120px;margin-top:6px;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:74px&quot;&gt;ASR&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:98px&quot;&gt;Atributo&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:262px&quot;&gt;Alcance · artefacto (relleno)&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:208px&quot;&gt;Participa sin modificarse (contorno)&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:208px&quot;&gt;Táctica principal&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:198px&quot;&gt;Medida&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top;white-space:nowrap&quot;&gt;&lt;span style=&quot;background:#1F4E79;color:#fff;font-weight:bold;padding:1px 5px;border-radius:4px&quot;&gt;ASR-L04&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Latencia&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Carril liviano (pool propio) · Carril pesado (pool propio) · Recepción y verificación (clasificar por tamaño)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Log distribuido de eventos&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;DIS-22 Bulkhead + LAT-03 clasificar al recibir&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;p99 de los pequeños con 5 masivos ≤ 1,10 × p99 sin masivos, en A&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top;white-space:nowrap&quot;&gt;&lt;span style=&quot;background:#2C7873;color:#fff;font-weight:bold;padding:1px 5px;border-radius:4px&quot;&gt;ASR-D01&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Disponibilidad&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Adaptadores de sistemas externos (circuit breaker por externo) · Orquestador de enriquecimiento (pendiente de enriquecimiento)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Gestor de pendientes · Verificador de revocación · Log distribuido de eventos · Recepción y verificación&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;INT-01 adaptador + DIS-21 circuit breaker + DIS-12 pendientes&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;p99 ≤ 1 s del último byte al acuse, con un externo caído o lento, en C1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top;white-space:nowrap&quot;&gt;&lt;span style=&quot;background:#5B3F8C;color:#fff;font-weight:bold;padding:1px 5px;border-radius:4px&quot;&gt;ASR-S06&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Seguridad&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Verificador de revocación (verificación pendiente) · Recepción y verificación (verificar firma y estampa) · Resultado, consulta y proyectores (retener el resultado)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Custodia de archivos&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;SEG-02 autenticar + DIS-14 verificación pendiente&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;0 archivos aceptados sin firma, estampa y revocación verificadas, en A y C1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top;white-space:nowrap&quot;&gt;&lt;span style=&quot;background:#9A5B13;color:#fff;font-weight:bold;padding:1px 5px;border-radius:4px&quot;&gt;ASR-M01&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Modificabilidad&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Configuración versionada (alta de la regla)&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Núcleo de validación&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;MOD-09 reglas como datos + MOD-12 activación reversible&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;≤ 4 h-persona de la especificación aprobada a producción&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="630" y="1376.3" width="1150" height="261" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dg-cst-001" name="DG-CST-001 · Recepción y verificación (caja blanca)"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="&lt;b&gt;DG-CST-001&lt;/b&gt; · Caja blanca de Recepción y verificación (N1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1399.1" height="24" as="geometry"/></mxCell><mxCell id="titulo__meta" value="caja blanca · refina: Recepción y verificación · ASR ASR-L04, ASR-S06, ASR-D01 · ADR ADR-002, ADR-004, ADR-005" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="1399.1" height="14" as="geometry"/></mxCell><mxCell id="rec" value="«component»&lt;br&gt;&lt;b&gt;Recepción y verificación&lt;/b&gt;" style="html=1;whiteSpace=wrap;verticalAlign=top;align=center;spacingTop=6;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#2B3642;fila=C4;" vertex="1" parent="1"><mxGeometry x="40" y="144" width="1399.1" height="554.6" as="geometry"/></mxCell><mxCell id="rec__ico" value="" style="shape=module;jettyWidth=8;jettyHeight=4;fillColor=#FFFFFF;strokeColor=#2B3642;" vertex="1" parent="rec"><mxGeometry x="1371.1" y="8" width="20" height="20" as="geometry"/></mxCell><mxCell id="receptor" value="«boundary»&lt;br&gt;receptor : ReceptorStreaming&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;«tactic» {id = SEG-08}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{sin DTD ni entidades externas}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="rec"><mxGeometry x="704.3" y="101" width="187" height="77.2" as="geometry"/></mxCell><mxCell id="custodio" value="«adapter»&lt;br&gt;custodio : EscritorDeCustodia&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;«tactic» {id = SEG-11}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{hash SHA-256 de los bytes custodiados}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFF4D6;strokeColor=#B8860B;fila=C1;" vertex="1" parent="rec"><mxGeometry x="1142.6" y="453.4" width="232.4" height="77.2" as="geometry"/></mxCell><mxCell id="auth" value="«control»&lt;br&gt;authenticator : VerificadorCriptografico&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;«tactic» {id = SEG-02, variante = un-factor}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFF4D6;strokeColor=#B8860B;fila=C1;" vertex="1" parent="rec"><mxGeometry x="677.8" y="242.9" width="239.8" height="64" as="geometry"/></mxCell><mxCell id="proof" value="«entity»&lt;br&gt;proofOfIdentity : FirmaYEstampa&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{authenticity}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="rec"><mxGeometry x="548.3" y="369.4" width="204.5" height="64" as="geometry"/></mxCell><mxCell id="clas" value="«control»&lt;br&gt;clasificador : ClasificadorPorTamano&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;«tactic» {id = LAT-03}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{umbral en bytes ≈ 50 registros}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFF4D6;strokeColor=#B8860B;fila=C1;" vertex="1" parent="rec"><mxGeometry x="238.4" y="235.2" width="225.3" height="77.2" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Lo verificado es lo procesado&lt;/b&gt;: ADR-004: la&lt;br&gt;firma se verifica sobre los mismos&lt;br&gt;bytes que se custodian y se procesan" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="rec"><mxGeometry x="883.1" y="463.2" width="249.5" height="57.6" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Precio&lt;/b&gt;: ADR-004: en un masivo&lt;br&gt;la verificación puede pasar de&lt;br&gt;200 ms; sale acuse de custodia&lt;br&gt;y el resultado se retiene" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="rec"><mxGeometry x="483.7" y="239.5" width="184.1" height="70.8" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Clasificar sin abrir&lt;/b&gt;: ADR-002: elige&lt;br&gt;el carril por el tamaño en bytes.&lt;br&gt;Precio: un mediano mal estimado&lt;br&gt;cae en el liviano (SUP-07)" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="rec"><mxGeometry x="24" y="238.4" width="204.4" height="70.8" as="geometry"/></mxCell><mxCell id="iRec" value="IRecepcion" style="ellipse;html=1;fontSize=11;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="827.7" y="76" width="20" height="20" as="geometry"/></mxCell><mxCell id="iRev" value="IRevocacion" style="shape=requiredInterface;html=1;fontSize=11;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;verticalLabelPosition=bottom;verticalAlign=top;direction=north;" vertex="1" parent="1"><mxGeometry x="867.7" y="746.6" width="20" height="10" as="geometry"/></mxCell><mxCell id="iCus" value="ICustodia" style="shape=requiredInterface;html=1;fontSize=11;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;verticalLabelPosition=bottom;verticalAlign=top;direction=north;" vertex="1" parent="1"><mxGeometry x="1288.9" y="746.6" width="20" height="10" as="geometry"/></mxCell><mxCell id="iPub" value="IPublicarEvento" style="shape=requiredInterface;html=1;fontSize=11;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;verticalLabelPosition=bottom;verticalAlign=top;direction=north;" vertex="1" parent="1"><mxGeometry x="381.1" y="746.6" width="20" height="10" as="geometry"/></mxCell><mxCell id="pCus" value="pCustodia" style="html=1;labelPosition=left;verticalLabelPosition=bottom;align=right;verticalAlign=top;fontSize=11;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;" vertex="1" parent="1"><mxGeometry x="1290.9" y="690.6" width="16" height="16" as="geometry"/></mxCell><mxCell id="pPub" value="pPublicar" style="html=1;labelPosition=left;verticalLabelPosition=bottom;align=right;verticalAlign=top;fontSize=11;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;" vertex="1" parent="1"><mxGeometry x="383.1" y="690.6" width="16" height="16" as="geometry"/></mxCell><mxCell id="pRec" value="pRecepcion" style="html=1;labelPosition=left;verticalLabelPosition=top;align=right;verticalAlign=bottom;fontSize=11;fillColor=#E8F0FA;strokeColor=#
ontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2B3642;fontColor=#1F2A36;" edge="1" parent="1" source="auth" target="pRev"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="877.7" y="450.9"/><mxPoint x="877.7" y="690.6"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r10" value="clasificar(tamañoEnBytes)" style="endArrow=none;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2B3642;fontColor=#1F2A36;" edge="1" parent="1" source="receptor" target="clas"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="791" y="322.2"/><mxPoint x="791" y="332.2"/><mxPoint x="391.1" y="332.2"/><mxPoint x="391.1" y="379.2"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r11" value="«delegate»" style="endArrow=open;endSize=10;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2B3642;fontColor=#1F2A36;" edge="1" parent="1" source="clas" target="pPub"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="391.1" y="456.4"/><mxPoint x="391.1" y="690.6"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="n1__a0" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9A8B4F;dashPattern=2 3;" edge="1" parent="1" source="n1" target="custodio"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1172.6" y="636"/><mxPoint x="1182.6" y="636"/></Array></mxGeometry></mxCell><mxCell id="n2__a0" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9A8B4F;dashPattern=2 3;" edge="1" parent="1" source="n2" target="auth"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="707.8" y="418.9"/><mxPoint x="717.8" y="418.9"/></Array></mxGeometry></mxCell><mxCell id="n3__a0" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9A8B4F;dashPattern=2 3;" edge="1" parent="1" source="n3" target="clas"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="268.4" y="417.8"/><mxPoint x="278.4" y="417.8"/></Array></mxGeometry></mxCell><mxCell id="pRev__asr1" value="ASR-D01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#2C7873;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#2C7873;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="pRev"><mxGeometry x="8" y="-10" width="54" height="18" as="geometry"/></mxCell><mxCell id="receptor__asr0" value="ASR-L04" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="receptor"><mxGeometry x="8" y="-10" width="53" height="18" as="geometry"/></mxCell><mxCell id="receptor__asr2" value="ASR-S06" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#5B3F8C;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#5B3F8C;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="receptor"><mxGeometry x="65" y="-10" width="53" height="18" as="geometry"/></mxCell><mxCell id="custodio__asr2" value="ASR-S06" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#5B3F8C;strokeColor=#5B3F8C;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="custodio"><mxGeometry x="8" y="-10" width="53" height="18" as="geometry"/></mxCell><mxCell id="auth__asr2" value="ASR-S06" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#5B3F8C;strokeColor=#5B3F8C;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="auth"><mxGeometry x="8" y="-10" width="53" height="18" as="geometry"/></mxCell><mxCell id="proof__asr2" value="ASR-S06" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#5B3F8C;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#5B3F8C;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="proof"><mxGeometry x="8" y="-10" width="53" height="18" as="geometry"/></mxCell><mxCell id="clas__asr0" value="ASR-L04" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="clas"><mxGeometry x="8" y="-10" width="53" height="18" as="geometry"/></mxCell><mxCell id="leyenda__lg" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;relleno ámbar: artefacto de un ASR (ahí se aplica la táctica o se hace el cambio)&lt;br&gt;borde ámbar: participa en la respuesta, pero no se modifica&lt;br&gt;blanco: fuera del alcance de los ASR de esta página&lt;br&gt;azul: punto de contacto (interfaz, puerto o evento)&lt;br&gt;nota: la decisión, atada con punteada a su elemento&lt;br&gt;—○ la bola: interfaz que el componente &lt;b&gt;provee&lt;/b&gt;&lt;br&gt;—( el semicírculo: interfaz que el componente &lt;b&gt;requiere&lt;/b&gt;&lt;br&gt;□ sobre el borde: puerto, con su interfaz junto a él&lt;br&gt;«tactic» {id = …}: el elemento aplica esa táctica del catálogo" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=42;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40" y="781.6" width="560" height="148" as="geometry"/></mxCell><mxCell id="leyenda__lg__m0" value="" style="text;html=1;fillColor=#FFF4D6;strokeColor=#B8860B;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="22.2" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m1" value="" style="text;html=1;fillColor=#FFFFFF;strokeColor=#B8860B;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="35.4" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m2" value="" style="text;html=1;fillColor=#FFFFFF;strokeColor=#2B3642;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="48.6" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m3" value="" style="text;html=1;fillColor=#E8F0FA;strokeColor=#3D6A9E;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="61.8" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m4" value="" style="text;html=1;fillColor=#FFFDE7;strokeColor=#9A8B4F;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="75" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__cv" value="&lt;b&gt;Convención ASR&lt;/b&gt; · cada elemento lleva la insignia de los ASR en cuyo alcance está" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40" y="947.6" width="560" height="168" as="geometry"/></mxCell><mxCell id="leyenda__cv__b0" value="ASR-L04" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="27" width="54" height="18" as="geometry"/></mxCell><mxCell id="leyenda__cv__t0" value="Aislamiento de carga entre masivos y&lt;br&gt;pequeños" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="72" y="26" width="207" height="34" as="geometry"/></mxCell><mxCell id="leyenda__cv__b1" value="ASR-D01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#2C7873;strokeColor=#2C7873;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="287" y="27" width="54" height="18" as="geometry"/></mxCell><mxCell id="leyenda__cv__t1" value="Aislamiento de fallas de los sistemas&lt;br&gt;externos" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="347" y="26" width="207" height="34" as="geometry"/></mxCell><mxCell id="leyenda__cv__b2" value="ASR-S06" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#5B3F8C;strokeColor=#5B3F8C;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="65" width="54" height="18" as="geometry"/></mxCell><mxCell id="leyenda__cv__t2" value="Ningún archivo aceptado sin validación&lt;br&gt;criptográfica completa" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="72" y="64" width="207" height="34" as="geometry"/></mxCell><mxCell id="leyenda__cv__fa" value="ASR-L04" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="115" width="53" height="18" as="geometry"/></mxCell><mxCell id="leyenda__cv__fat" value="&lt;b&gt;relleno&lt;/b&gt;: artefacto del ASR (ahí se aplica la táctica o se hace el cambio)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="71" y="114" width="500" height="20" as="geometry"/></mxCell><mxCell id="leyenda__cv__fp" value="ASR-L04" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="139" width="53" height="18" as="geometry"/></mxCell><mxCell id="leyenda__cv__fpt" value="&lt;b&gt;contorno punteado&lt;/b&gt;: participa en la respuesta, pero no se modifica" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="71" y="138" width="500" height="20" as="geometry"/></mxCell><mxCell id="leyenda__traz" value="&lt;b style=&quot;font-size:13px&quot;&gt;Trazabilidad ASR → elementos de la arquitectura&lt;/b&gt; &amp;nbsp;(★ priorizado)&lt;table style=&quot;border-collapse:collapse;table-layout:fixed;width:1120px;margin-top:6px;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:73px&quot;&gt;ASR&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:98px&quot;&gt;Atributo&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:263px&quot;&gt;Alcance · artefacto (relleno)&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:208px&quot;&gt;Participa sin modificarse (contorno)&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:208px&quot;&gt;Táctica principal&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:198px&quot;&gt;Medida&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top;white-space:nowrap&quot;&gt;&lt;span style=&quot;background:#1F4E79;color:#fff;font-weight:bold;padding:1px 5px;border-radius:4px&quot;&gt;ASR-L04&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Latencia&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;clasificador : ClasificadorPorTamano&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;receptor : ReceptorStreaming&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;DIS-22 Bulkhead + LAT-03 clasificar al recibir&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;p99 de los pequeños con 5 masivos ≤ 1,10 × p99 sin masivos, en A&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top;white-space:nowrap&quot;&gt;&lt;span style=&quot;background:#2C7873;color:#fff;font-weight:bold;padding:1px 5px;border-radius:4px&quot;&gt;ASR-D01&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Disponibilidad&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;authenticationInformation : IRevocacion&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;INT-01 adaptador + DIS-21 circuit breaker + DIS-12 pendientes&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;p99 ≤ 1 s del último byte al acuse, con un externo caído o lento, en C1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top;white-space:nowrap&quot;&gt;&lt;span style=&quot;background:#5B3F8C;color:#fff;font-weight:bold;padding:1px 5px;border-radius:4px&quot;&gt;ASR-S06&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Seguridad&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;custodio : EscritorDeCustodia · authenticator : VerificadorCriptografico&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;receptor : ReceptorStreaming · proofOfIdentity : FirmaYEstampa&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;SEG-02 autenticar + DIS-14 verificación pendiente&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;0 archivos aceptados sin firma, estampa y revocación verificadas, en A y C1&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="630" y="781.6" width="1150" height="182" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dg-cst-002" name="DG-CST-002 · Adaptadores (caja blanca)"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="&lt;b&gt;DG-CST-002&lt;/b&gt; · Caja blanca de Adaptadores de sistemas externos (N1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1165.4" height="24" as="geometry"/></mxCell><mxCell id="titulo__meta" value="caja blanca · refina: Adaptadores de sistemas externos · ASR ASR-D01 · ADR ADR-006" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="1165.4" height="14" as="geometry"/></mxCell><mxCell id="adp" value="«component»&lt;br&gt;&lt;b&gt;Adaptadores de sistemas externos&lt;/b&gt;" style="html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingTop=6;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#2B3642;fila=C4;spacingLeft=523.2;" vertex="1" parent="1"><mxGeometry x="101.7" y="144" width="1165.4" height="598.2" as="geometry"/></mxCell><mxCell id="adp__ico" value="" style="shape=module;jettyWidth=8;jettyHeight=4;fillColor=#FFFFFF;strokeColor=#2B3642;" vertex="1" parent="adp"><mxGeometry x="1137.4" y="8" width="20" height="20" as="geometry"/></mxCell><mxCell id="client" value="«control»&lt;br&gt;client : ConsultaProtegida" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="adp"><mxGeometry x="424.1" y="134" width="166.1" height="50.8" as="geometry"/></mxCell><mxCell id="cb" value="«control»&lt;br&gt;circuitBreaker : Interruptor&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;«tactic» {id = DIS-21, variante = temporizador}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{umbral = TBD · espera = TBD}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFF4D6;strokeColor=#B8860B;fila=C1;" vertex="1" parent="adp"><mxGeometry x="379.3" y="241.8" width="255.9" height="77.2" as="geometry"/></mxCell><mxCell id="st" value="«entity»&lt;br&gt;breakerState : EstadoCircuito&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{uno por sistema externo}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="adp"><mxGeometry x="875.1" y="379.4" width="186.3" height="64" as="geometry"/></mxCell><mxCell id="ad" value="«adapter»&lt;br&gt;adapter : AdaptadorPorExterno&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;«tactic» {id = INT-01, variante = interfaz-común}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{distancia = sintáctica y semántica · control = tercero}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFF4D6;strokeColor=#B8860B;fila=C1;" vertex="1" parent="adp"><mxGeometry x="362" y="376" width="290.4" height="77.2" as="geometry"/></mxCell><mxCell id="sc" value="«adapter»&lt;br&gt;supplierClient : ClienteConTimeout&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{T_call = TBD}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="adp"><mxGeometry x="399.6" y="510.2" width="215.2" height="64" as="geometry"/></mxCell><mxCell id="cuInt" value="INT-01 : Adapter" style="ellipse;html=1;dashed=1;whiteSpace=wrap;fontSize=11;fillColor=none;strokeColor=#7A8794;fila=C7;" vertex="1" parent="adp"><mxGeometry x="1001.4" y="64" width="140" height="50" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Falla rápida&lt;/b&gt;: ADR-006: con el&lt;br&gt;circuito abierto la consulta falla de&lt;br&gt;inmediato y la declaración pasa a&lt;br&gt;pendiente; nadie espera al externo" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="adp"><mxGeometry x="172.2" y="245" width="197.1" height="70.8" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Precio&lt;/b&gt;: ADR-006: aparece el&lt;br&gt;estado «pendiente de&lt;br&gt;enriquecimiento». Umbral, espera&lt;br&gt;y T_call quedan por fijar con BCR" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="adp"><mxGeometry x="672.4" y="376" width="192.7" height="70.8" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Un adaptador por externo&lt;/b&gt;: IContratoExterno&lt;br&gt;es la API de cada externo. Un contrato&lt;br&gt;nuevo cambia solo su adaptador" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="adp"><mxGeometry x="100" y="385.8" width="252" height="57.6" as="geometry"/></mxCell><mxCell id="iCE" value="IConsultaExterna" style="ellipse;html=1;fontSize=11;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="598.9" y="76" width="20" height="20" as="geometry"/></mxCell><mxCell id="iCon" value="IContratoExterno" style="shape=requiredInterface;html=1;fontSize=11;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;verticalLabelPosition=bottom;verticalAlign=top;direction=north;" vertex="1" parent="1"><mxGeometry x="598.9" y="790.2" width="20" height="10" as="geometry"/></mxCell><mxCell id="iPub" value="IPublicarEvento" style="shape=requiredInterface;html=1;fontSize=11;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;verticalLabelPosition=bottom;verticalAlign=top;direction=north;" vertex="1" parent="1"><mxGeometry x="180.7" y="790.2" width="20" height="10" as="geometry"/></mxCell><mxCell id="pEv" value="breakerEvents : IPublicarEvento" style="html=1;labelPosition=left;verticalLabelPosition=bottom;align=right;verticalAlign=top;fontSize=11;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;" vertex="1" parent="1"><mxGeometry x="182.7" y="734.2" width="16" height="16" as="geometry"/></mxCell><mxCell id="pSup" value="supplier : IContratoExterno" style="html=1;labelPosition=left;verticalLabelPosition=bottom;align=right;verticalAlign=top;fontSize=11;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;" vertex="1" parent="1"><mxGeometry x="600.9" y="734.2" width="16" height="16" as="geometry"/></mxCell><mxCell id="pTar" value="target : IConsultaExterna" style="html=1;labelPosition=left;vertic
<mxfile host="diagramar-uml-arquitectura"><diagram id="dg-cmp-001" name="DG-CMP-001 · Contexto de Orquídea"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="&lt;b&gt;DG-CMP-001&lt;/b&gt; · Contexto: Orquídea, sus remitentes y los sistemas que BCR no controla" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1625" height="24" as="geometry"/></mxCell><mxCell id="titulo__meta" value="componentes · ASR ASR-D01, ASR-L04, ASR-S06 · ADR ADR-001, ADR-002, ADR-003, ADR-006, ADR-007" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="1625" height="14" as="geometry"/></mxCell><mxCell id="a_rem" value="Remitente" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#FFFFFF;strokeColor=#2B3642;fila=C4;" vertex="1" parent="1"><mxGeometry x="110" y="91.8" width="30" height="60" as="geometry"/></mxCell><mxCell id="i_rec" value="IRecibirArchivo" style="shape=providedRequiredInterface;html=1;verticalLabelPosition=bottom;sketch=0;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;" vertex="1" parent="1"><mxGeometry x="570.8" y="111.8" width="20" height="20" as="geometry"/></mxCell><mxCell id="sys" value="«subsystem»&lt;br&gt;&lt;b&gt;Orquídea&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=middle;fillColor=none;strokeColor=#2B3642;fila=C6;" vertex="1" parent="1"><mxGeometry x="692.1" y="95.4" width="150" height="52.8" as="geometry"/></mxCell><mxCell id="sys__ico" value="" style="shape=module;jettyWidth=8;jettyHeight=4;fillColor=#FFFFFF;strokeColor=#2B3642;" vertex="1" parent="sys"><mxGeometry x="122" y="8" width="20" height="20" as="geometry"/></mxCell><mxCell id="a_ope" value="Operador de BCR" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#FFFFFF;strokeColor=#2B3642;fila=C4;" vertex="1" parent="1"><mxGeometry x="1244.6" y="76" width="30" height="60" as="geometry"/></mxCell><mxCell id="x_ter" value="«external»&lt;br&gt;&lt;b&gt;STM · ANTA · MAMC · RNIC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{control = tercero-fuera-de-control}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=middle;fillColor=#F2F2F2;strokeColor=#7A8794;fila=C5;" vertex="1" parent="1"><mxGeometry x="1211.1" y="376.6" width="232.1" height="66" as="geometry"/></mxCell><mxCell id="x_ter__ico" value="" style="shape=module;jettyWidth=8;jettyHeight=4;fillColor=#FFFFFF;strokeColor=#2B3642;" vertex="1" parent="x_ter"><mxGeometry x="204.1" y="8" width="20" height="20" as="geometry"/></mxCell><mxCell id="x_ecd" value="«external»&lt;br&gt;&lt;b&gt;ECD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;{control = tercero-fuera-de-control}&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=middle;fillColor=#F2F2F2;strokeColor=#7A8794;fila=C5;" vertex="1" parent="1"><mxGeometry x="1211.1" y="482.6" width="232.1" height="66" as="geometry"/></mxCell><mxCell id="x_ecd__ico" value="" style="shape=module;jettyWidth=8;jettyHeight=4;fillColor=#FFFFFF;strokeColor=#2B3642;" vertex="1" parent="x_ecd"><mxGeometry x="204.1" y="8" width="20" height="20" as="geometry"/></mxCell><mxCell id="x_are" value="«external»&lt;br&gt;&lt;b&gt;Áreas consumidoras de BCR&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=middle;fillColor=#F2F2F2;strokeColor=#7A8794;fila=C5;" vertex="1" parent="1"><mxGeometry x="1214.2" y="197" width="229" height="52.8" as="geometry"/></mxCell><mxCell id="x_are__ico" value="" style="shape=module;jettyWidth=8;jettyHeight=4;fillColor=#FFFFFF;strokeColor=#2B3642;" vertex="1" parent="x_are"><mxGeometry x="201" y="8" width="20" height="20" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Caídas de horas&lt;/b&gt;: STM, ANTA,&lt;br&gt;MAMC, RNIC o la ECD pueden caer&lt;br&gt;2 a 20 h o más; Orquídea sigue&lt;br&gt;recibiendo y acusando (ASR-D01)" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="1"><mxGeometry x="1459.3" y="374.2" width="205.7" height="70.8" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Carga&lt;/b&gt;: 1 a 100 000 registros&lt;br&gt;y hasta 50 MB; 400&lt;br&gt;pequeños/min con 5 masivos&lt;br&gt;en proceso (ASR-L04)" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="1"><mxGeometry x="40" y="188.8" width="169.9" height="70.8" as="geometry"/></mxCell><mxCell id="r0" value="" style="endArrow=none;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2B3642;fontColor=#1F2A36;flujo=inverso;" edge="1" parent="1" source="sys" target="i_rec"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="692.1" y="121.8"/><mxPoint x="590.8" y="121.8"/></Array></mxGeometry></mxCell><mxCell id="r1" value="envía archivo XML firmado (HTTPS);&lt;br&gt;recibe acuse y resultado definitivo" style="endArrow=none;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2B3642;fontColor=#1F2A36;flujo=directo;" edge="1" parent="1" source="a_rem" target="i_rec"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="139.9" y="121.8"/><mxPoint x="570.8" y="121.8"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r2" value="enriquecer declaración · API (protocolo TBD)" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2B3642;fontColor=#1F2A36;" edge="1" parent="1" source="sys" target="x_ter"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="842.1" y="127.1"/><mxPoint x="876.1" y="127.1"/><mxPoint x="876.1" y="409.6"/><mxPoint x="1211.1" y="409.6"/></Array><mxPoint x="97.7" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r3" value="CRL · OCSP · estampa" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2B3642;fontColor=#1F2A36;" edge="1" parent="1" source="sys" target="x_ecd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="842.1" y="137.7"/><mxPoint x="866.1" y="137.7"/><mxPoint x="866.1" y="515.6"/><mxPoint x="1211.1" y="515.6"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r4" value="supervisión de la operación" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2B3642;fontColor=#1F2A36;" edge="1" parent="1" source="sys" target="a_ope"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="842.1" y="106"/><mxPoint x="1244.6" y="106"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r5" value="entrega de datos (fuera de esta iteración)" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2B3642;fontColor=#1F2A36;" edge="1" parent="1" source="sys" target="x_are"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="842.1" y="116.6"/><mxPoint x="886.1" y="116.6"/><mxPoint x="886.1" y="223.4"/><mxPoint x="1214.2" y="223.4"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="n1__a0" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9A8B4F;dashPattern=2 3;" edge="1" parent="1" source="n1" target="x_ter"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1459.3" y="409.6"/><mxPoint x="1451.3" y="409.6"/><mxPoint x="1443.3" y="409.6"/></Array></mxGeometry></mxCell><mxCell id="n2__a0" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9A8B4F;dashPattern=2 3;" edge="1" parent="1" source="n2" target="a_rem"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="188.8"/><mxPoint x="125" y="151.8"/></Array></mxGeometry></mxCell><mxCell id="sys__asr0" value="ASR-D01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="sys"><mxGeometry x="8" y="-10" width="54" height="18" as="geometry"/></mxCell><mxCell id="sys__asr1" value="ASR-L04" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#2C7873;strokeColor=#2C7873;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="sys"><mxGeometry x="66" y="-10" width="53" height="18" as="geometry"/></mxCell><mxCell id="sys__asr2" value="ASR-S06" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#5B3F8C;strokeColor=#5B3F8C;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="sys"><mxGeometry x="8" y="-32" width="53" height="18" as="geometry"/></mxCell><mxCell id="x_ter__asr0" value="ASR-D01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="x_ter"><mxGeometry x="8" y="-10" width="54" height="18" as="geometry"/></mxCell><mxCell id="x_ecd__asr0" value="ASR-D01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="x_ecd"><mxGeometry x="8" y="-10" width="54" height="18" as="geometry"/></mxCell><mxCell id="x_ecd__asr2" value="ASR-S06" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#5B3F8C;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#5B3F8C;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="x_ecd"><mxGeometry x="66" y="-10" width="53" height="18" as="geometry"/></mxCell><mxCell id="leyenda__lg" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;blanco: fuera del alcance de los ASR de esta página&lt;br&gt;gris: sistema fuera de nuestro control&lt;br&gt;marco: la frontera del sistema&lt;br&gt;azul: punto de contacto (interfaz, puerto o evento)&lt;br&gt;nota: la decisión, atada con punteada a su elemento&lt;br&gt;bola dentro del semicírculo: ensamble entre quien &lt;b&gt;provee&lt;/b&gt; la interfaz y quien la &lt;b&gt;requiere&lt;/b&gt;&lt;br&gt;«external»: sistema fuera de nuestro control" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=42;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40" y="573.6" width="560" height="120" as="geometry"/></mxCell><mxCell id="leyenda__lg__m0" value="" style="text;html=1;fillColor=#FFFFFF;strokeColor=#2B3642;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="22.2" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m1" value="" style="text;html=1;fillColor=#F2F2F2;strokeColor=#7A8794;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="35.4" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m2" value="" style="text;html=1;fillColor=none;strokeColor=#2B3642;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="48.6" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m3" value="" style="text;html=1;fillColor=#E8F0FA;strokeColor=#3D6A9E;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="61.8" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m4" value="" style="text;html=1;fillColor=#FFFDE7;strokeColor=#9A8B4F;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="75" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__cv" value="&lt;b&gt;Convención ASR&lt;/b&gt; · cada elemento lleva la insignia de los ASR en cuyo alcance está" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40" y="711.6" width="560" height="168" as="geometry"/></mxCell><mxCell id="leyenda__cv__b0" value="ASR-D01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="27" width="54" height="18" as="geometry"/></mxCell><mxCell id="leyenda__cv__t0" value="Ningún archivo se rechaza por la caída&lt;br&gt;de un externo" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="72" y="26" width="207" height="34" as="geometry"/></mxCell><mxCell id="leyenda__cv__b1" value="ASR-L04" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#2C7873;strokeColor=#2C7873;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="287" y="27" width="54" height="18" as="geometry"/></mxCell><mxCell id="leyenda__cv__t1" value="Aislamiento entre masivos y pequeños" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="347" y="26" width="207" height="20" as="geometry"/></mxCell><mxCell id="leyenda__cv__b2" value="ASR-S06" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#5B3F8C;strokeColor=#5B3F8C;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="65" width="54" height="18" as="geometry"/></mxCell><mxCell id="leyenda__cv__t2" value="Ningún archivo se acepta sin&lt;br&gt;verificación completa" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="72" y="64" width="207" height="34" as="geometry"/></mxCell><mxCell id="leyenda__cv__fa" value="ASR-D01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="115" width="54" height="18" as="geometry"/></mxCell><mxCell id="leyenda__cv__fat" value="&lt;b&gt;relleno&lt;/b&gt;: artefacto del ASR (ahí se aplica la táctica o se hace el cambio)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="72" y="114" width="500" height="20" as="geometry"/></mxCell><mxCell id="leyenda__cv__fp" value="ASR-D01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="139" width="54" height="18" as="geometry"/></mxCell><mxCell id="leyenda__cv__fpt" value="&lt;b&gt;contorno punteado&lt;/b&gt;: participa en la respuesta, pero no se modifica" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="72" y="138" width="500" height="20" as="geometry"/></mxCell><mxCell id="leyenda__traz" value="&lt;b style=&quot;font-size:13px&quot;&gt;Trazabilidad ASR → elementos de la arquitectura&lt;/b&gt; &amp;nbsp;(★ priorizado)&lt;table style=&quot;border-collapse:collapse;table-layout:fixed;width:1120px;margin-top:6px;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:73px&quot;&gt;ASR&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:98px&quot;&gt;Atributo&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:263px&quot;&gt;Alcance · artefacto (relleno)&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:208px&quot;&gt;Participa sin modificarse (contorno)&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:208px&quot;&gt;Táctica principal&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px;width:198px&quot;&gt;Medida&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top;white-space:nowrap&quot;&gt;&lt;span style=&quot;background:#1F4E79;color:#fff;font-weight:bold;padding:1px 5px;border-radius:4px&quot;&gt;ASR-D01&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Disponibilidad · recuperación&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Orquídea&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;STM · ANTA · MAMC · RNIC · ECD&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Monitor, pendientes durables y ventana nocturna&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;100 % de los archivos válidos procesados dentro de los días de reintento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top;white-space:nowrap&quot;&gt;&lt;span style=&quot;background:#2C7873;color:#fff;font-weight:bold;padding:1px 5px;border-radius:4px&quot;&gt;ASR-L04&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Latencia&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Orquídea&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Dos carriles aislados con enrutador por tamaño&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;p99 ≤ 3 s por archivo pequeño con 5 masivos en proceso&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top;white-space:nowrap&quot;&gt;&lt;span style=&quot;background:#5B3F8C;color:#fff;font-weight:bold;padding:1px 5px;border-radius:4px&quot;&gt;ASR-S06&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Seguridad · prevención&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Orquídea&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;ECD&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Verificación completa con resultado retenido&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;0 archivos aceptados sin firma, firmante, cadena, estampa y revocación verificadas&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="630" y="573.6" width="1150" height="196" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

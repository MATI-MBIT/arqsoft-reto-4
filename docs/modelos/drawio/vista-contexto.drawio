xt"><mxGeometry x="8" y="-10" width="54" height="18" as="geometry"/></mxCell><mxCell id="ecd__asr1" value="ASR-D01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#2C7873;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#2C7873;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="ecd"><mxGeometry x="8" y="-10" width="54" height="18" as="geometry"/></mxCell><mxCell id="ecd__asr2" value="ASR-S06" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#5B3F8C;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#5B3F8C;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="ecd"><mxGeometry x="66" y="-10" width="53" height="18" as="geometry"/></mxCell><mxCell id="leyenda__lg" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;relleno ámbar: artefacto de un ASR (ahí se aplica la táctica o se hace el cambio)&lt;br&gt;borde ámbar: participa en la respuesta, pero no se modifica&lt;br&gt;gris: sistema fuera de nuestro control&lt;br&gt;azul: punto de contacto (interfaz, puerto o evento)&lt;br&gt;nota: la decisión, atada con punteada a su elemento&lt;br&gt;bola dentro del semicírculo: ensamble entre quien &lt;b&gt;provee&lt;/b&gt; la interfaz y quien la &lt;b&gt;requiere&lt;/b&gt;&lt;br&gt;«external»: sistema fuera de nuestro control" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=42;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40" y="463.4" width="560" height="120" as="geometry"/></mxCell><mxCell id="leyenda__lg__m0" value="" style="text;html=1;fillColor=#FFF4D6;strokeColor=#B8860B;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="22.2" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m1" value="" style="text;html=1;fillColor=#FFFFFF;strokeColor=#B8860B;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="35.4" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m2" value="" style="text;html=1;fillColor=#F2F2F2;strokeColor=#7A8794;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="48.6" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m3" value="" style="text;html=1;fillColor=#E8F0FA;strokeColor=#3D6A9E;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="61.8" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m4" value="" style="text;html=1;fillColor=#FFFDE7;strokeColor=#9A8B4F;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="75" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__cv" value="&lt;b&gt;Convención ASR&lt;/b&gt; · cada elemento lleva la insignia de los ASR en cuyo alcance está" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40" y="601.4" width="560" height="168" as="geometry"/></mxCell><mxCell id="leyenda__cv__b0" value="ASR-L04" style="text;rounded=1;arcSize=30;html=1;whiteSpace=nowrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="27" width="55" height="18" as="geometry"/></mxCell><mxCell id="leyenda__cv__t0" value="Aislamiento de carga entre masivos y&lt;br&gt;pequeños" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="73" y="26" width="206" height="34" as="geometry"/></mxCell><mxC
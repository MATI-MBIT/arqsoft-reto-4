<mxfile host="diagramar-uml-arquitectura"><diagram id="dg-cmp-001" name="DG-CMP-001 · Contexto"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="&lt;b&gt;DG-CMP-001&lt;/b&gt; · Contexto de Orquídea: con quién habla y qué intercambia" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1F2A36;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1177.2" height="24" as="geometry"/></mxCell><mxCell id="titulo__meta" value="componentes · ASR ASR-L04, ASR-D01, ASR-S06, ASR-M01 · ADR ADR-001, ADR-004, ADR-005, ADR-006, ADR-008" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#5A6B7D;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="1177.2" height="14" as="geometry"/></mxCell><mxCell id="rem" value="Remitente (IMC o titular)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="1"><mxGeometry x="122.9" y="270.6" width="30" height="60" as="geometry"/></mxCell><mxCell id="iRecC" value="IRecepcion" style="shape=providedRequiredInterface;html=1;verticalLabelPosition=bottom;sketch=0;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;" vertex="1" parent="1"><mxGeometry x="327.6" y="290.6" width="20" height="20" as="geometry"/></mxCell><mxCell id="orq" value="«component»&lt;br&gt;&lt;b&gt;Orquídea&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=middle;fillColor=#FFF4D6;strokeColor=#B8860B;fila=C1;" vertex="1" parent="1"><mxGeometry x="439.4" y="265.4" width="150" height="52.8" as="geometry"/></mxCell><mxCell id="orq__ico" value="" style="shape=module;jettyWidth=8;jettyHeight=4;fillColor=#FFFFFF;strokeColor=#2B3642;" vertex="1" parent="orq"><mxGeometry x="122" y="8" width="20" height="20" as="geometry"/></mxCell><mxCell id="iActC" value="IActivacion" style="shape=providedRequiredInterface;html=1;verticalLabelPosition=bottom;sketch=0;fillColor=#E8F0FA;strokeColor=#3D6A9E;fila=C8;" vertex="1" parent="1"><mxGeometry x="327.6" y="96" width="20" height="20" as="geometry"/></mxCell><mxCell id="ti" value="Equipo de TI de BCR" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#FFFFFF;strokeColor=#B8860B;fila=C3;" vertex="1" parent="1"><mxGeometry x="122.9" y="76" width="30" height="60" as="geometry"/></mxCell><mxCell id="ext" value="«external»&lt;br&gt;&lt;b&gt;STM · ANTA · MAMC · RNIC&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=middle;fillColor=#F2F2F2;strokeColor=#7A8794;fila=C5;" vertex="1" parent="1"><mxGeometry x="942.4" y="172.6" width="218.9" height="52.8" as="geometry"/></mxCell><mxCell id="ext__ico" value="" style="shape=module;jettyWidth=8;jettyHeight=4;fillColor=#FFFFFF;strokeColor=#2B3642;" vertex="1" parent="ext"><mxGeometry x="190.9" y="8" width="20" height="20" as="geometry"/></mxCell><mxCell id="ecd" value="«external»&lt;br&gt;&lt;b&gt;Entidad de certificación digital (ECD)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=middle;fillColor=#F2F2F2;strokeColor=#7A8794;fila=C5;" vertex="1" parent="1"><mxGeometry x="942.4" y="265.4" width="274.8" height="52.8" as="geometry"/></mxCell><mxCell id="ecd__ico" value="" style="shape=module;jettyWidth=8;jettyHeight=4;fillColor=#FFFFFF;strokeColor=#2B3642;" vertex="1" parent="ecd"><mxGeometry x="246.8" y="8" width="20" height="20" as="geometry"/></mxCell><mxCell id="areas" value="«external»&lt;br&gt;&lt;b&gt;Áreas consumidoras de BCR&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontSize=12;verticalAlign=middle;fillColor=#F2F2F2;strokeColor=#7A8794;fila=C5;" vertex="1" parent="1"><mxGeometry x="942.4" y="358.2" width="229" height="52.8" as="geometry"/></mxCell><mxCell id="areas__ico" value="" style="shape=module;jettyWidth=8;jettyHeight=4;fillColor=#FFFFFF;strokeColor=#2B3642;" vertex="1" parent="areas"><mxGeometry x="201" y="8" width="20" height="20" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Fuera de control&lt;/b&gt;: BCR no controla&lt;br&gt;STM, ANTA, MAMC, RNIC ni la&lt;br&gt;ECD. ADR-001: el acuse no&lt;br&gt;espera a ninguno de ellos" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="1"><mxGeometry x="951.5" y="85.8" width="200.7" height="70.8" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Archivos firmados&lt;/b&gt;: XML&lt;br&gt;firmado con estampa, de 1 a 100&lt;br&gt;000 registros y hasta 50 MB. Se&lt;br&gt;acusa antes de procesar" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="1"><mxGeometry x="43.7" y="367.6" width="188.4" height="70.8" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Reglas como datos&lt;/b&gt;: ADR-008: TI&lt;br&gt;activa una regla nueva como&lt;br&gt;dato versionado, sin redesplegar" style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="1"><mxGeometry x="40" y="173" width="195.8" height="57.6" as="geometry"/></mxCell><mxCell id="r0" value="" style="endArrow=none;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2B3642;fontColor=#1F2A36;flujo=directo;" edge="1" parent="1" source="rem" target="iRecC"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="152.9" y="300.6"/><mxPoint x="327.6" y="300.6"/></Array></mxGeometry></mxCell><mxCell id="r1" value="" style="endArrow=none;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2B3642;fontColor=#1F2A36;flujo=inverso;" edge="1" parent="1" source="orq" target="iRecC"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="439.4" y="300.6"/><mxPoint x="347.6" y="300.